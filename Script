-- ==================== AUTO FARM ====================
task.spawn(function()
    while task.wait(0.05) do
        if _G.AutoFarm and Character then
            local hrp = Character:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local closestLeaf, closestDist = nil, math.huge
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Parent then
                    local name = obj.Name:lower()
                    if name:find("leaf") or name:find("leaves") or name:find("la") or name:find("tree") or name:find("cay") then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist < closestDist then closestLeaf, closestDist = obj, dist end
                    end
                end
            end
            if closestLeaf then
                hrp.CFrame = CFrame.new(closestLeaf.Position + Vector3.new(0, 3, 0))
                task.wait(0.03)
                local tool = Character:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                    for _, child in pairs(tool:GetDescendants()) do
                        if child:IsA("RemoteEvent") then
                            pcall(function() child:FireServer() end)
                        end
                    end
                end
                local cd = closestLeaf:FindFirstChildOfClass("ClickDetector")
                if cd then pcall(fireclickdetector, cd) end
                local pp = closestLeaf:FindFirstChildOfClass("ProximityPrompt")
                if pp then pcall(fireproximityprompt, pp) end
                pcall(function() closestLeaf:Destroy() end)
            end
        end
    end
end)

-- ==================== FLY ====================
RunService.RenderStepped:Connect(function()
    if _G.Fly and Character then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        local humanoid = Character:FindFirstChild("Humanoid")
        if hrp and humanoid then
            humanoid.PlatformStand = true
            local speed = 80
            local moveDir = Vector3.new(0, 0, 0)
            local camera = workspace.CurrentCamera

            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir + Vector3.new(0, -1, 0) end

            if _G.FlyDir.L then moveDir = moveDir + Vector3.new(-1, 0, 0) end
            if _G.FlyDir.R then moveDir = moveDir + Vector3.new(1, 0, 0) end
            if _G.FlyDir.U then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if _G.FlyDir.D then moveDir = moveDir + Vector3.new(0, -1, 0) end
            if _G.FlyDir.F then
                local camLook = camera.CFrame.LookVector
                moveDir = moveDir + Vector3.new(camLook.X, 0, camLook.Z)
            end

            if moveDir.Magnitude > 0 then
                hrp.Velocity = moveDir.Unit * speed
            else
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

-- ==================== TỐC ĐỘ ====================
local function setMySpeed(speed)
    if Character then
        local humanoid = Character:FindFirstChild("Humanoid")
        if humanoid then humanoid.WalkSpeed = speed end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.SpeedMap then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.WalkSpeed < 100 then hum.WalkSpeed = 100 end
                end
            end
        end
    end
end)

