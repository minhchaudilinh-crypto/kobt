            gb.Font = Enum.Font.GothamBold
            gb.TextSize = 9
            Instance.new("UICorner", gb).CornerRadius = UDim.new(0, 4)

            -- Nút KÉO
            local bb = Instance.new("TextButton", row)
            bb.Size = UDim2.new(0.18, 0, 0, 20)
            bb.Position = UDim2.new(0.6, 0, 0, 3)
            bb.BackgroundColor3 = Color3.fromRGB(200, 100, 60)
            bb.Text = "KÉO"
            bb.TextColor3 = Color3.fromRGB(255, 255, 255)
            bb.Font = Enum.Font.GothamBold
            bb.TextSize = 9
            Instance.new("UICorner", bb).CornerRadius = UDim.new(0, 4)

            -- 🏃 Nút CẤP SPEED
            local sb = Instance.new("TextButton", row)
            sb.Size = UDim2.new(0.18, 0, 0, 20)
            sb.Position = UDim2.new(0.8, 0, 0, 3)
            sb.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
            sb.Text = "🏃"
            sb.TextColor3 = Color3.fromRGB(255, 255, 255)
