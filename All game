-- ========== TROLL: RUNG LẮC ==========
trollShake.MouseButton1Click:Connect(function()
    if not selectedPlayer or not selectedPlayer.Character then return end
    local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local startPos = hrp.CFrame
    local conn
    local count = 0
    conn = R.Heartbeat:Connect(function()
        count = count + 1
        if count > 60 then conn:Disconnect(); return end
        local hd = selectedPlayer.Character
        if not hd then conn:Disconnect(); return end
        local h = hd:FindFirstChild("HumanoidRootPart")
        if not h then conn:Disconnect(); return end
        h.CFrame = startPos * CFrame.new(
            math.random(-3,3)/10,
            math.random(-3,3)/10,
            math.random(-3,3)/10
        )
    end)
    game:GetService("Debris"):AddItem(Instance.new("Folder"),0)
    trollShake.BackgroundColor3 = YE
    wait(1)
    trollShake.BackgroundColor3 = RD
end)

-- ========== TROLL: ĐỐT CHÁY ==========
trollFire.MouseButton1Click:Connect(function()
    if not selectedPlayer or not selectedPlayer.Character then return end
    local char = selectedPlayer.Character
    for _,pt in pairs(char:GetDescendants()) do
        if pt:IsA("BasePart") and pt.Name ~= "HumanoidRootPart" then
            local f = Instance.new("Fire",pt)
            f.Size = 5
            f.Heat = 10
            game:GetService("Debris"):AddItem(f,5)
        end
    end
    trollFire.BackgroundColor3 = YE
    wait(0.2)
    trollFire.BackgroundColor3 = OR
end)

-- ========== TROLL: ĐÓNG BĂNG ==========
local frozenPlayers = {}
trollFreeze.MouseButton1Click:Connect(function()
    if not selectedPlayer or not selectedPlayer.Character then return end
    local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if frozenPlayers[selectedPlayer] then
        frozenPlayers[selectedPlayer]:Destroy()
        frozenPlayers[selectedPlayer] = nil
    else
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9,9e9,9e9)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = hrp
        frozenPlayers[selectedPlayer] = bv
        selectedPlayer.CharacterAdded:Connect(function()
            if frozenPlayers[selectedPlayer] then frozenPlayers[selectedPlayer]:Destroy(); frozenPlayers[selectedPlayer] = nil end
        end)
    end
    trollFreeze.BackgroundColor3 = YE
    wait(0.2)
    trollFreeze.BackgroundColor3 = CY
end)

