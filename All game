local espActive = false
local showDistance = true
local showName = true
local showBox = true
local showLine = true
local espObjects = {}   -- Lưu các object ESP để xoá sau

-- Hàm tạo ESP cho 1 người chơi
local function createESP(targetPlayer)
    -- Xoá ESP cũ nếu có
    if espObjects[targetPlayer] then
        for _, obj in pairs(espObjects[targetPlayer]) do
            if obj and obj.Parent then obj:Destroy() end
        end
    end

    espObjects[targetPlayer] = {}

    -- Highlight (làm sáng nhân vật)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = targetPlayer.Character
    table.insert(espObjects[targetPlayer], highlight)

    -- BillboardGui hiện tên + khoảng cách
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "ESP_Name"
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = targetPlayer.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard
    table.insert(espObjects[targetPlayer], billboard)

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "ESP_Distance"
    distLabel.Size = UDim2.new(1, 0, 0, 18)
    distLabel.Position = UDim2.new(0, 0, 0, 22)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0 studs"
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    distLabel.TextStrokeTransparency = 0
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextSize = 12
    distLabel.Parent = billboard

    -- Cập nhật khoảng cách liên tục
    local distConn = RunService.RenderStepped:Connect(function()
        if not espActive or not targetPlayer.Character then return end
        if not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end

        local myPos = player.Character.HumanoidRootPart.Position
        local theirPos = targetPlayer.Character.HumanoidRootPart.Position
        local dist = math.floor((myPos - theirPos).Magnitude)
        distLabel.Text = dist .. " studs"
    end)
    table.insert(espObjects[targetPlayer], {Destroy = function() distConn:Disconnect() end})
end

-- Hàm xoá ESP
local function removeESP(targetPlayer)
    if espObjects[targetPlayer] then
        for _, obj in pairs(espObjects[targetPlayer]) do
            if typeof(obj) == "table" and obj.Destroy then
                obj.Destroy()
            elseif obj and obj.Parent then
                obj:Destroy()
            end
        end
        espObjects[targetPlayer] = nil
    end
end

-- Hàm bật/tắt ESP
local function updateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if espActive then
                createESP(p)
            else
                removeESP(p)
            end
        end
    end
end

