local espActive, espObjects = false, {}

local function createESP(p)
    if not p.Character then return end
    espObjects[p] = {}
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = p.Character
    table.insert(espObjects[p], hl)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = p.Character:FindFirstChild("Head") or p.Character
    local nm = Instance.new("TextLabel", bb)
    nm.Size = UDim2.new(1, 0, 0, 20)
    nm.BackgroundTransparency = 1
    nm.Text = p.Name
    nm.TextColor3 = Color3.fromRGB(255, 255, 255)
    nm.TextStrokeTransparency = 0
    nm.Font = Enum.Font.GothamBold
    nm.TextSize = 13
    local dl = Instance.new("TextLabel", bb)
    dl.Size = UDim2.new(1, 0, 0, 18)
    dl.Position = UDim2.new(0, 0, 0, 20)
    dl.BackgroundTransparency = 1
    dl.Text = "..."
    dl.TextColor3 = Color3.fromRGB(255, 255, 100)
    dl.TextStrokeTransparency = 0
    dl.Font = Enum.Font.GothamBold
    dl.TextSize = 11
    table.insert(espObjects[p], bb)
    local conn = RS.RenderStepped:Connect(function()
        if not espActive then return end
        if not p.Character or not player.Character then return end
        local a = p.Character:FindFirstChild("HumanoidRootPart")
        local b = player.Character:FindFirstChild("HumanoidRootPart")
        if a and b then dl.Text = math.floor((a.Position - b.Position).Magnitude) .. " studs" end
    end)
    table.insert(espObjects[p], {Disconnect = function() conn:Disconnect() end})
end

local function removeESP(p)
    if espObjects[p] then
        for _, o in pairs(espObjects[p]) do
            if type(o) == "table" and o.Disconnect then o:Disconnect()
            elseif o and o.Parent then o:Destroy() end
        end
        espObjects[p] = nil
    end
end

local function updateAllESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            if espActive then createESP(p) else removeESP(p) end
        end
    end
end

espBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    espBtn.Text = espActive and "👁️ ESP: BẬT" or "👁️ ESP: TẮT"
    espBtn.BackgroundColor3 = espActive and Color3.fromRGB(200, 60, 60) or Color3.fromRGB(60, 200, 100)
    updateAllESP()
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        if espActive then createESP(p) end
    end)
end)
Players.PlayerRemoving:Connect(removeESP)

