local selP = nil

local function updateTList()
    for _,c in pairs(tList:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _,p in pairs(P:GetPlayers()) do
        if p ~= L then
            local b = Instance.new("TextButton",tList)
            b.Size = UDim2.new(1,-8,0,24)
            b.BackgroundColor3 = PN
            b.Text = p.Name
            b.TextColor3 = WH
            b.Font = Enum.Font.GothamBold
            b.TextSize = 10
            b.AutoButtonColor = false
            b.BorderSizePixel = 0
            corner(b,5)
            b.MouseButton1Click:Connect(function()
                selP = p
                tB2.Text = "MỤC TIÊU: " .. p.Name
                tList.Visible = false
            end)
        end
    end
end

tB2.MouseButton1Click:Connect(function()
    updateTList()
    tList.Visible = not tList.Visible
end)

