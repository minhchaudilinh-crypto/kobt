function updateList()
    local fl = string.lower(sBox.Text)
    for _,c in pairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _,p in pairs(P:GetPlayers()) do
        if p ~= L then
            if fl == "" or string.find(string.lower(p.Name),fl,1,true) then
                local row = Instance.new("Frame",list)
                row.Size = UDim2.new(1,-10,0,32)
                row.BackgroundColor3 = PN
                row.BorderSizePixel = 0
                corner(row,6); stroke(row,BD,1,0.7)

                local n = Instance.new("TextLabel",row)
                n.Size = UDim2.new(0.4,0,1,0)
                n.Position = UDim2.new(0,5,0,0)
                n.BackgroundTransparency = 1
                n.Text = p.Name
                n.TextColor3 = WH
                n.Font = Enum.Font.Gotham
                n.TextSize = 10
                n.TextXAlignment = Enum.TextXAlignment.Left
                n.TextTruncate = Enum.TextTruncate.AtEnd

                local function sB(txt,x,clr)
                    local b = Instance.new("TextButton",row)
                    b.Size = UDim2.new(0.18,0,0,22)
                    b.Position = UDim2.new(x,0,0,5)
                    b.BackgroundColor3 = clr
                    b.Text = txt
                    b.TextColor3 = WH
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    b.AutoButtonColor = false
                    b.BorderSizePixel = 0
                    corner(b,5); stroke(b,WH,1,0.85)
                    return b
                end

                local dB = sB("ĐẾN",0.4,BL)
                local kB = sB("KÉO",0.6,OR)
                local tB2 = sB("THEO",0.8,PU)

                dB.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then mh.CFrame = th.CFrame + Vector3.new(0,0,3) end
                    end
                end)

                kB.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then th.CFrame = mh.CFrame + Vector3.new(0,0,3) end
                    end
                end)

                tB2.MouseButton1Click:Connect(function()
                    if follow[p] then
                        follow[p]:Disconnect()
                        follow[p] = nil
                        tB2.Text = "THEO"
                        tB2.BackgroundColor3 = PU
                    else
                        tB2.Text = "THẢ"
                        tB2.BackgroundColor3 = RD
                        follow[p] = R.Heartbeat:Connect(function()
                            local mc = L.Character
                            local tc = p.Character
                            if not mc or not tc then return end
                            local mh = mc:FindFirstChild("HumanoidRootPart")
                            local th = tc:FindFirstChild("HumanoidRootPart")
                            if mh and th then th.CFrame = mh.CFrame + Vector3.new(3,0,3) end
                        end)
                    end
                end)
            end
        end
    end
end

