    end
end)

-- LOGIC BAY
local isF, fConn, bv = false, nil, nil
flyBtn.MouseButton1Click:Connect(function()
    isF = not isF
    if isF then
        flyBtn.Text = "BAY: BẬT"
        flyBtn.BackgroundColor3 = RD
        fc.Visible = true
        local c = L.Character
        if not c then isF = false; fc.Visible = false; return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then isF = false; fc.Visible = false; return end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = hrp
        fConn = R.RenderStepped:Connect(function()
            if not bv or not bv.Parent then return end
            local sp = tonumber(flyBox.Text) or 50
            local dir = Vector3.new(0, 0, 0)
            local lk = C.CFrame.LookVector
            local rt = C.CFrame.RightVector
            if fD.f then dir = dir + lk end
            if fD.b then dir = dir - lk end
            if fD.r then dir = dir + rt end
            if fD.l then dir = dir - rt end
            if fD.u then dir = dir + Vector3.new(0, 1, 0) end
            if fD.d then dir = dir - Vector3.new(0, 1, 0) end
            if U:IsKeyDown(Enum.KeyCode.W) then dir = dir + lk end
            if U:IsKeyDown(Enum.KeyCode.S) then dir = dir - lk end
            if U:IsKeyDown(Enum.KeyCode.A) then dir = dir - rt end
            if U:IsKeyDown(Enum.KeyCode.D) then dir = dir + rt end
            if U:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if U:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            bv.Velocity = dir.Magnitude > 0 and dir.Unit * sp or Vector3.new(0, 0, 0)
        end)
    else
        flyBtn.Text = "BAY: TẮT"
        flyBtn.BackgroundColor3 = BL
        fc.Visible = false
        if fConn then fConn:Disconnect() end
        if bv then bv:Destroy() end
        for k, _ in pairs(fD) do fD[k] = false end
    end
end)

-- LOGIC ESP
local espOn = false
local espK = true
local espT = true
local espD = true
local espH = true
local eObjs = {}

local function rmESP(p)
    if eObjs[p] then
        if eObjs[p].hl then eObjs[p].hl:Destroy() end
        if eObjs[p].bb then eObjs[p].bb:Destroy() end
        if eObjs[p].conn then eObjs[p].conn:Disconnect() end
        eObjs[p] = nil
    end
end

local function mkESP(p)
    if not p.Character then return end
    rmESP(p)
    eObjs[p] = {}
    local ch = p.Character
    local hd = ch:FindFirstChild("Head")
    local hm = ch:FindFirstChildOfClass("Humanoid")

    if espK then
        local hl = Instance.new("Highlight")
        hl.FillColor = RD
        hl.OutlineColor = WH
        hl.FillTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = ch
        eObjs[p].hl = hl
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 60)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = hd or ch
    eObjs[p].bb = bb

    if espT then
        local nm = Instance.new("TextLabel", bb)
        nm.Size = UDim2.new(1, 0, 0, 20)
        nm.BackgroundTransparency = 1
        nm.Text = p.Name
        nm.TextColor3 = WH
        nm.TextStrokeTransparency = 0
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 13
    end

    if espD then
        local dl = Instance.new("TextLabel", bb)
        dl.Size = UDim2.new(1, 0, 0, 18)
        dl.Position = UDim2.new(0, 0, 0, 20)
        dl.BackgroundTransparency = 1
        dl.Text = "..."
        dl.TextColor3 = Color3.fromRGB(240, 200, 60)
        dl.TextStrokeTransparency = 0
        dl.Font = Enum.Font.GothamBold
        dl.TextSize = 11
        eObjs[p].dl = dl
    end

    if espH and hm then
        local hpBg = Instance.new("Frame", bb)
        hpBg.Size = UDim2.new(0.8, 0, 0, 6)
        hpBg.Position = UDim2.new(0.1, 0, 0, 42)
        hpBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        hpBg.BorderSizePixel = 0
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 3)

        local hpBar = Instance.new("Frame", hpBg)
        hpBar.Size = UDim2.new(1, 0, 1, 0)
        hpBar.BackgroundColor3 = GR
        hpBar.BorderSizePixel = 0
        Instance.new("UICorner", hpBar).CornerRadius = UDim.new(0, 3)
        eObjs[p].hp = hpBar
    end

    eObjs[p].conn = R.RenderStepped:Connect(function()
        if not espOn then return end
        local mc = L.Character
        local tc = p.Character
        if not mc or not tc then return end
        local mh = mc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChild("HumanoidRootPart")
        if eObjs[p] and eObjs[p].dl and mh and th then
            eObjs[p].dl.Text = math.floor((mh.Position - th.Position).Magnitude) .. " studs"
        end
        if eObjs[p] and eObjs[p].hp then
            local h = tc:FindFirstChildOfClass("Humanoid")
            if h then
                local r = h.Health / h.MaxHealth
                eObjs[p].hp.Size = UDim2.new(r, 0, 1, 0)
                if r > 0.5 then
                    eObjs[p].hp.BackgroundColor3 = GR
                elseif r > 0.25 then
                    eObjs[p].hp.BackgroundColor3 = Color3.fromRGB(240, 200, 60)
                else
                    eObjs[p].hp.BackgroundColor3 = RD
                end
            end
        end
    end)
end

local function upESP()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= L then
            if espOn then mkESP(p) else rmESP(p) end
        end
    end
end

