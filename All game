local ivBtn = btn(ptool,"TANG HINH: TAT",37,GR)
local ivOn = false

local function setInvis(v)
    local c = L.Character
    if not c then return end
    for _,pt in pairs(c:GetDescendants()) do
        if pt:IsA("BasePart") then
            pt.Transparency = v and 1 or 0
            pt.CanCollide = true
        elseif pt:IsA("Decal") then
            pt.Transparency = v and 1 or 0
        elseif pt:IsA("Accessory") then
            for _,a in pairs(pt:GetDescendants()) do
                if a:IsA("BasePart") then a.Transparency = v and 1 or 0 end
            end
        end
    end
end

