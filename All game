                nameLbl.Font = Enum.Font.Gotham
                nameLbl.TextSize = 10
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

                local function smallBtn(text, x, color)
                    local b = Instance.new("TextButton", row)
                    b.Size = UDim2.new(0.18, 0, 0, 22)
                    b.Position = UDim2.new(x, 0, 0, 5)
                    b.BackgroundColor3 = color
                    b.Text = text
                    b.TextColor3 = WHITE
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    b.AutoButtonColor = false
                    b.BorderSizePixel = 0
                    addCorner(b, 5)
                    addStroke(b, WHITE, 1, 0.85)
                    return b
                end

                local denBtn = smallBtn("ĐẾN", 0.4, BLUE)
                local keoBtn = smallBtn("KÉO", 0.6, ORANGE)
                local theoBtn = smallBtn("THEO", 0.8, PURPLE)

                denBtn.MouseButton1Click:Connect(function()
                    local mc, tc = LocalPlayer.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then mh.CFrame = th.CFrame + Vector3.new(0, 0, 3) end
                    end
                end)

                keoBtn.MouseButton1Click:Connect(function()
                    local mc, tc = LocalPlayer.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then th.CFrame = mh.CFrame + Vector3.new(0, 0, 3) end
                    end
                end)

                theoBtn.MouseButton1Click:Connect(function()
                    if followConns[p] then
                        followConns[p]:Disconnect()
                        followConns[p] = nil
                        theoBtn.Text = "THEO"
                        theoBtn.BackgroundColor3 = PURPLE
                    else
                        theoBtn.Text = "THẢ"
                        theoBtn.BackgroundColor3 = RED
                        followConns[p] = RunService.Heartbeat:Connect(function()
                            local mc = LocalPlayer.Character
                            local tc = p.Character
                            if not mc or not tc then return end
                            local mh = mc:FindFirstChild("HumanoidRootPart")
                            local th = tc:FindFirstChild("HumanoidRootPart")
                            if mh and th then th.CFrame = mh.CFrame + Vector3.new(3, 0, 3) end
                        end)
                    end
                end)
            end
        end
    end
end

