    dl.TextStrokeTransparency = 0
    dl.Font = Enum.Font.GothamBold
    dl.TextSize = 11

    table.insert(espObjects[p], bb)

    local conn = RS.RenderStepped:Connect(function()
        if not espActive then return end
        if not p.Character or not LP.Character then return end
        local a = p.Character:FindFirstChild("HumanoidRootPart")
        local b = LP.Character:FindFirstChild("HumanoidRootPart")
        if a and b then dl.Text = math.floor((a.Position - b.Position).Magnitude) .. " studs" end
    end)
    table.insert(espObjects[p], {Disconnect = function() conn:Disconnect() end})
end

local function removeESP(p)
    if espObjects[p] then
        for _, o in pairs(espObjects[p]) do
            if type(o) == "table" and o.Disconnect then o:Disconnect()
            elseif o and o.Parent then o:Destroy() end
        end
        espObjects[p] = nil
    end
end

local function updateAllESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            if espActive then createESP(p) else removeESP(p) end
        end
    end
end

