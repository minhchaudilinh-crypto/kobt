local selectedPlayer = nil

local function updateTargetList()
    for _,c in pairs(targetList:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _,p in pairs(P:GetPlayers()) do
        if p ~= L then
            local b = Instance.new("TextButton",targetList)
            b.Size = UDim2.new(1,-8,0,24)
            b.BackgroundColor3 = PN
            b.Text = p.Name
            b.TextColor3 = WH
            b.Font = Enum.Font.GothamBold
            b.TextSize = 10
            b.AutoButtonColor = false
            b.BorderSizePixel = 0
            corner(b,5)
            b.MouseButton1Click:Connect(function()
                selectedPlayer = p
                targetBtn.Text = "MỤC TIÊU: " .. p.Name
                targetList.Visible = false
            end)
        end
    end
end

targetBtn.MouseButton1Click:Connect(function()
    updateTargetList()
    targetList.Visible = not targetList.Visible
end)

