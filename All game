-- ===== HÀM TẠO NÚT ĐẸP =====
local function makeBtn(parent, txt, y, h, clr, size)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.92, 0, 0, h or 32)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = clr or CLR.accent1
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = size or 12
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", b)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.85
    stroke.Thickness = 1

    -- Hover
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Color3.new(
            math.min(clr.R * 1.3, 1),
            math.min(clr.G * 1.3, 1),
            math.min(clr.B * 1.3, 1)
        )
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = clr
    end)
    return b
end

-- ===== HÀM TẠO Ô NHẬP ĐẸP =====
local function makeBox(parent, placeholder, y, txt)
    local b = Instance.new("TextBox", parent)
    b.Size = UDim2.new(0.92, 0, 0, 30)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = CLR.input
    b.PlaceholderText = placeholder
    b.Text = txt or ""
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.PlaceholderColor3 = Color3.fromRGB(130, 130, 150)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local s = Instance.new("UIStroke", b)
    s.Color = CLR.accent1
    s.Transparency = 0.7
    s.Thickness = 1
    return b
end

