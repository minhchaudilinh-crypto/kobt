-- ===== FLY LOGIC =====
local isFly, flyConn, bv = false, nil, nil
flyBtn.MouseButton1Click:Connect(function()
    isFly = not isFly
    if isFly then
        flyBtn.Text = "BAY: BAT"
        flyBtn.BackgroundColor3 = RED
        fc.Visible = true
        local c = LP.Character
        if not c then isFly = false; fc.Visible = false; return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then isFly = false; fc.Visible = false; return end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp
        flyConn = RS.RenderStepped:Connect(function()
            if not bv or not bv.Parent then return end
            local sp = tonumber(flySpeedBox.Text) or 50
            local dir = Vector3.new(0, 0, 0)
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            if fDirs.forward then dir = dir + look end
            if fDirs.back then dir = dir - look end
            if fDirs.right then dir = dir + right end
            if fDirs.left then dir = dir - right end
            if fDirs.up then dir = dir + Vector3.new(0, 1, 0) end
            if fDirs.down then dir = dir - Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            bv.Velocity = dir.Magnitude > 0 and dir.Unit * sp or Vector3.new(0, 0, 0)
        end)
    else
        flyBtn.Text = "BAY: TAT"
        flyBtn.BackgroundColor3 = BLUE
        fc.Visible = false
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if bv then bv:Destroy(); bv = nil end
        for k, _ in pairs(fDirs) do fDirs[k] = false end
    end
end)

-- ===== ESP LOGIC =====
local espActive = false
local showBox = true
local showName = true
local showDist = true
local showHp = true
local showLine = false
local espObjs = {}

local function removeESP(p)
    if espObjs[p] then
        for _, obj in pairs(espObjs[p].parts) do
            if obj and obj.Parent then obj:Destroy() end
        end
        if espObjs[p].line and espObjs[p].line.Parent then espObjs[p].line:Destroy() end
        if espObjs[p].conn then espObjs[p].conn:Disconnect() end
        espObjs[p] = nil
    end
end

local function createESP(p)
    if not p.Character then return end
    removeESP(p)
    espObjs[p] = {parts = {}}

    local char = p.Character
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if showBox then
        local hl = Instance.new("Highlight")
        hl.FillColor = RED
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        table.insert(espObjs[p].parts, hl)
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 70)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head or char
    table.insert(espObjs[p].parts, bb)

    if showName then
        local nm = Instance.new("TextLabel", bb)
        nm.Size = UDim2.new(1, 0, 0, 20)
        nm.BackgroundTransparency = 1
        nm.Text = p.Name
        nm.TextColor3 = Color3.fromRGB(255, 255, 255)
        nm.TextStrokeTransparency = 0
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 13
    end

    if showDist then
        local dl = Instance.new("TextLabel", bb)
        dl.Size = UDim2.new(1, 0, 0, 18)
        dl.Position = UDim2.new(0, 0, 0, 20)
        dl.BackgroundTransparency = 1
        dl.Text = "..."
        dl.TextColor3 = YELLOW
        dl.TextStrokeTransparency = 0
        dl.Font = Enum.Font.GothamBold
        dl.TextSize = 11
        espObjs[p].dist = dl
    end

    if showHp and hum then
        local hpBg = Instance.new("Frame", bb)
        hpBg.Size = UDim2.new(0.8, 0, 0, 6)
        hpBg.Position = UDim2.new(0.1, 0, 0, 42)
        hpBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        hpBg.BorderSizePixel = 0
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 3)

        local hpBar = Instance.new("Frame", hpBg)
        hpBar.Size = UDim2.new(1, 0, 1, 0)
        hpBar.BackgroundColor3 = GREEN
        hpBar.BorderSizePixel = 0
        Instance.new("UICorner", hpBar).CornerRadius = UDim.new(0, 3)
        espObjs[p].hpBar = hpBar
    end

    if showLine then
        local line = Instance.new("Frame", sg)
        line.BackgroundColor3 = RED
        line.BorderSizePixel = 0
        line.Visible = false
        line.ZIndex = 999
        espObjs[p].line = line
    end

    local conn = RS.RenderStepped:Connect(function()
        if not espActive then return end
        local myChar = LP.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        local tChar = p.Character
        if not tChar then return end
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        local tHead = tChar:FindFirstChild("Head")
        if not tHrp or not tHead then return end

        if espObjs[p] and espObjs[p].dist then
            local d = math.floor((myHrp.Position - tHrp.Position).Magnitude)
            espObjs[p].dist.Text = d .. " studs"
        end

        if espObjs[p] and espObjs[p].hpBar then
            local h = tChar:FindFirstChildOfClass("Humanoid")
            if h then
                local r = h.Health / h.MaxHealth
                espObjs[p].hpBar.Size = UDim2.new(r, 0, 1, 0)
                if r > 0.5 then
                    espObjs[p].hpBar.BackgroundColor3 = GREEN
                elseif r > 0.25 then
                    espObjs[p].hpBar.BackgroundColor3 = YELLOW
                else
                    espObjs[p].hpBar.BackgroundColor3 = RED
                end
            end
        end

        if espObjs[p] and espObjs[p].line then
            local pos, onScreen = cam:WorldToViewportPoint(tHead.Position)
            if onScreen then
                local sx = cam.ViewportSize.X / 2
                local sy = cam.ViewportSize.Y
                local ex, ey = pos.X, pos.Y
                local len = math.sqrt((ex - sx)^2 + (ey - sy)^2)
                local ang = math.atan2(ey - sy, ex - sx)
                espObjs[p].line.Position = UDim2.new(0, sx, 0, sy)
                espObjs[p].line.Size = UDim2.new(0, len, 0, 2)
                espObjs[p].line.Rotation = math.deg(ang)
                espObjs[p].line.Visible = true
            else
                espObjs[p].line.Visible = false
            end
        end
    end)
    espObjs[p].conn = conn
end

