function updatePlayerList()
    local filter = string.lower(searchBox.Text)
    for _, c in pairs(playerList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            if filter == "" or string.find(string.lower(p.Name), filter, 1, true) then
                local row = Instance.new("Frame", playerList)
                row.Size = UDim2.new(1, -10, 0, 32)
                row.BackgroundColor3 = PANEL
                row.BorderSizePixel = 0
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local n = Instance.new("TextLabel", row)
                n.Size = UDim2.new(0.4, 0, 1, 0)
                n.Position = UDim2.new(0, 5, 0, 0)
                n.BackgroundTransparency = 1
                n.Text = p.Name
                n.TextColor3 = Color3.fromRGB(255, 255, 255)
                n.Font = Enum.Font.Gotham
                n.TextSize = 10
                n.TextXAlignment = Enum.TextXAlignment.Left
                n.TextTruncate = Enum.TextTruncate.AtEnd

                local function sBtn(txt, x, clr)
                    local b = Instance.new("TextButton", row)
                    b.Size = UDim2.new(0.18, 0, 0, 22)
                    b.Position = UDim2.new(x, 0, 0, 5)
                    b.BackgroundColor3 = clr
                    b.Text = txt
                    b.TextColor3 = Color3.fromRGB(255, 255, 255)
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    b.AutoButtonColor = false
                    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
                    return b
                end

                local gb = sBtn("DEN", 0.4, BLUE)
                local bb = sBtn("KEO", 0.6, ORANGE)
                local kb = sBtn("THEO", 0.8, PURPLE)

                gb.MouseButton1Click:Connect(function()
                    local mc, tc = LP.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then mh.CFrame = th.CFrame + Vector3.new(0, 0, 3) end
                    end
                end)

                bb.MouseButton1Click:Connect(function()
                    local mc, tc = LP.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then th.CFrame = mh.CFrame + Vector3.new(0, 0, 3) end
                    end
                end)

                kb.MouseButton1Click:Connect(function()
                    if keepConns[p] then
                        keepConns[p]:Disconnect()
                        keepConns[p] = nil
                        kb.BackgroundColor3 = PURPLE
                        kb.Text = "THEO"
                    else
                        kb.BackgroundColor3 = RED
                        kb.Text = "THA"
                        keepConns[p] = RS.Heartbeat:Connect(function()
                            local mc = LP.Character
                            local tc = p.Character
                            if not mc or not tc then return end
                            local mh = mc:FindFirstChild("HumanoidRootPart")
                            local th = tc:FindFirstChild("HumanoidRootPart")
                            if mh and th then
                                th.CFrame = mh.CFrame + Vector3.new(3, 0, 3)
                            end
                        end)
                    end
                end)
            end
        end
    end
end

