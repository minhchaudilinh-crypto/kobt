-- BAY
local flyOn, flyConn, flyV = false, nil, nil
flyB.MouseButton1Click:Connect(function()
    flyOn = not flyOn
    if flyOn then
        flyB.Text = "BAY: BẬT"
        flyB.BackgroundColor3 = RD
        flyP.Visible = true
        local c = L.Character
        if not c then flyOn=false; flyP.Visible=false; return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then flyOn=false; flyP.Visible=false; return end
        flyV = Instance.new("BodyVelocity")
        flyV.MaxForce = Vector3.new(9e9,9e9,9e9)
        flyV.Parent = hrp
        flyConn = R.RenderStepped:Connect(function()
            if not flyV or not flyV.Parent then return end
            local sp = tonumber(flyX.Text) or 50
            local dir = Vector3.new(0,0,0)
            local lk = C.CFrame.LookVector
            local rt = C.CFrame.RightVector
            if fI.forward then dir = dir + lk end
            if fI.back then dir = dir - lk end
            if fI.right then dir = dir + rt end
            if fI.left then dir = dir - rt end
            if fI.up then dir = dir + Vector3.new(0,1,0) end
            if fI.down then dir = dir - Vector3.new(0,1,0) end
            if U:IsKeyDown(Enum.KeyCode.W) then dir = dir + lk end
            if U:IsKeyDown(Enum.KeyCode.S) then dir = dir - lk end
            if U:IsKeyDown(Enum.KeyCode.A) then dir = dir - rt end
            if U:IsKeyDown(Enum.KeyCode.D) then dir = dir + rt end
            if U:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
            if U:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
            flyV.Velocity = dir.Magnitude > 0 and dir.Unit * sp or Vector3.new(0,0,0)
        end)
    else
        flyB.Text = "BAY: TẮT"
        flyB.BackgroundColor3 = BL
        flyP.Visible = false
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyV then flyV:Destroy(); flyV = nil end
        for k,_ in pairs(fI) do fI[k] = false end
    end
end)

-- ESP
local espOn, sK, sT, sD, sM = false, true, true, true, true
local espObj = {}

local function rmESP(p)
    if espObj[p] then
        for _,o in pairs(espObj[p]) do
            if o and o.Parent then o:Destroy() end
        end
        espObj[p] = nil
    end
end

local function mkESP(p)
    if not p.Character then return end
    rmESP(p)
    local list = {}
    local ch = p.Character
    local hd = ch:FindFirstChild("Head")
    local hm = ch:FindFirstChildOfClass("Humanoid")

    if sK then
        local hl = Instance.new("Highlight")
        hl.FillColor = RD
        hl.OutlineColor = WH
        hl.FillTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = ch
        table.insert(list, hl)
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,160,0,60)
    bb.StudsOffset = Vector3.new(0,3,0)
    bb.AlwaysOnTop = true
    bb.Parent = hd or ch
    table.insert(list, bb)

    if sT then
        local n = Instance.new("TextLabel",bb)
        n.Size = UDim2.new(1,0,0,20)
        n.BackgroundTransparency = 1
        n.Text = p.Name
        n.TextColor3 = WH
        n.TextStrokeTransparency = 0
        n.Font = Enum.Font.GothamBold
        n.TextSize = 13
    end

    local dLbl
    if sD then
        dLbl = Instance.new("TextLabel",bb)
        dLbl.Size = UDim2.new(1,0,0,18)
        dLbl.Position = UDim2.new(0,0,0,20)
        dLbl.BackgroundTransparency = 1
        dLbl.Text = "..."
        dLbl.TextColor3 = YE
        dLbl.TextStrokeTransparency = 0
        dLbl.Font = Enum.Font.GothamBold
        dLbl.TextSize = 11
    end

    local hp
    if sM and hm then
        local bg = Instance.new("Frame",bb)
        bg.Size = UDim2.new(0.8,0,0,6)
        bg.Position = UDim2.new(0.1,0,0,42)
        bg.BackgroundColor3 = Color3.fromRGB(50,50,60)
        bg.BorderSizePixel = 0
        corner(bg,3)
        hp = Instance.new("Frame",bg)
        hp.Size = UDim2.new(1,0,1,0)
        hp.BackgroundColor3 = GR
        hp.BorderSizePixel = 0
        corner(hp,3)
    end

    espObj[p] = {parts=list, dist=dLbl, hp=hp}
    espObj[p].conn = R.RenderStepped:Connect(function()
        if not espOn or not espObj[p] then return end
        local mc = L.Character
        local tc = p.Character
        if not mc or not tc then return end
        local mh = mc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChild("HumanoidRootPart")
        if not mh or not th then return end
        if espObj[p].dist then
            espObj[p].dist.Text = math.floor((mh.Position - th.Position).Magnitude) .. " studs"
        end
        if espObj[p].hp then
            local h = tc:FindFirstChildOfClass("Humanoid")
            if h then
                local r = h.Health / h.MaxHealth
                espObj[p].hp.Size = UDim2.new(r,0,1,0)
                espObj[p].hp.BackgroundColor3 = r > 0.5 and GR or (r > 0.25 and YE or RD)
            end
        end
    end)
end

local function upESP()
    for _,p in pairs(P:GetPlayers()) do
        if p ~= L then
            if espOn then mkESP(p) else rmESP(p) end
        end
    end
end

espB.MouseButton1Click:Connect(function()
    espOn = not espOn
    espB.Text = espOn and "ESP: BẬT" or "ESP: TẮT"
    espB.BackgroundColor3 = espOn and RD or GR
    upESP()
end)
espK.MouseButton1Click:Connect(function() sK=not sK; espK.Text=sK and "Khung: BẬT" or "Khung: TẮT"; if espOn then upESP() end end)
espT.MouseButton1Click:Connect(function() sT=not sT; espT.Text=sT and "Tên: BẬT" or "Tên: TẮT"; if espOn then upESP() end end)
espD.MouseButton1Click:Connect(function() sD=not sD; espD.Text=sD and "Khoảng cách: BẬT" or "Khoảng cách: TẮT"; if espOn then upESP() end end)
