local function corner(o,r) local c=Instance.new("UICorner",o); c.CornerRadius=UDim.new(0,r or 10); return c end
local function stroke(o,c,t,tr) local s=Instance.new("UIStroke",o); s.Color=c or BD; s.Thickness=t or 1; s.Transparency=tr or 0.4; return s end
local function grad(o,a,b,r) local g=Instance.new("UIGradient",o); g.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,a),ColorSequenceKeypoint.new(1,b)}; g.Rotation=r or 45; return g end

local function mkBtn(p,txt,y,clr,h)
    local b = Instance.new("TextButton",p)
    b.Size = UDim2.new(0.92,0,0,h or 30)
    b.Position = UDim2.new(0.04,0,0,y)
    b.BackgroundColor3 = clr or BL
    b.Text = txt
    b.TextColor3 = WH
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    corner(b,8)
    stroke(b,WH,1,0.85)
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Color3.new(math.min(clr.R+0.15,1), math.min(clr.G+0.15,1), math.min(clr.B+0.15,1))
    end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = clr end)
    return b
end

local function mkBox(p,ph,y,df)
    local b = Instance.new("TextBox",p)
    b.Size = UDim2.new(0.92,0,0,28)
    b.Position = UDim2.new(0.04,0,0,y)
    b.BackgroundColor3 = IN
    b.PlaceholderText = ph
    b.Text = df or ""
    b.TextColor3 = WH
    b.PlaceholderColor3 = Color3.fromRGB(140,140,160)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.BorderSizePixel = 0
    corner(b,6)
    stroke(b,BD,1,0.6)
    return b
end

