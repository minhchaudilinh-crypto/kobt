-- ===== HÀM TẠO NÚT =====
local function makeBtn(parent, txt, y, h, clr, size)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.92, 0, 0, h or 30)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = clr or BLUE
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = size or 12
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local function makeBox(parent, ph, y, txt)
    local b = Instance.new("TextBox", parent)
    b.Size = UDim2.new(0.92, 0, 0, 28)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = INPUT
    b.PlaceholderText = ph
    b.Text = txt or ""
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.PlaceholderColor3 = Color3.fromRGB(130, 130, 150)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end
