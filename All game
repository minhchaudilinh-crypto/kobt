                    b.Size = UDim2.new(0.18, 0, 0, 22)
                    b.Position = UDim2.new(x, 0, 0, 5)
                    b.BackgroundColor3 = clr
                    b.Text = txt
                    b.TextColor3 = WH
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    b.AutoButtonColor = false
                    b.BorderSizePixel = 0
                    corner(b, 5)
                    stroke(b, WH, 1, 0.85)
                    return b
                end

                local dB = sBtn("DEN", 0.4, BL)
                local kB = sBtn("KEO", 0.6, OR)
                local tB2 = sBtn("THEO", 0.8, PU)

                dB.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then mh.CFrame = th.CFrame + Vector3.new(0, 0, 3) end
                    end
                end)

                kB.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then th.CFrame = mh.CFrame + Vector3.new(0, 0, 3) end
