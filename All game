-- ===== NOCLIP =====
local ncOn, ncC = false, nil
ncB.MouseButton1Click:Connect(function()
    ncOn = not ncOn
    ncB.Text = ncOn and "XUYÊN TƯỜNG: BẬT" or "XUYÊN TƯỜNG: TẮT"
    ncB.BackgroundColor3 = ncOn and RD or GR
    if ncOn then
        ncC = R.Stepped:Connect(function()
            local c = L.Character
            if c then
                for _,pt in pairs(c:GetDescendants()) do
                    if pt:IsA("BasePart") then pt.CanCollide = false end
                end
            end
        end)
    elseif ncC then
        ncC:Disconnect(); ncC = nil
    end
end)

-- ===== TÀNG HÌNH =====
local ivOn = false
local function setIv(v)
    local c = L.Character
    if not c then return end
    for _,pt in pairs(c:GetDescendants()) do
        if pt:IsA("BasePart") or pt:IsA("Decal") then pt.Transparency = v and 1 or 0 end
    end
end
ivB.MouseButton1Click:Connect(function()
    ivOn = not ivOn
    ivB.Text = ivOn and "TÀNG HÌNH: BẬT" or "TÀNG HÌNH: TẮT"
    ivB.BackgroundColor3 = ivOn and RD or GR
    setIv(ivOn)
end)
L.CharacterAdded:Connect(function() if ivOn then wait(0.5); setIv(true) end end)

