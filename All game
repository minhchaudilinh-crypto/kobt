            local c = player.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h.WalkSpeed = tonumber(speedBox.Text) or 100 end
            end
        end)
    else
        speedBtn.Text = "⚡ SPEED: TẮT"
        speedBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
