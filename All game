local keep = {}

function upList()
    local fl = string.lower(searchBox.Text)
    for _,c in pairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _,p in pairs(P:GetPlayers()) do
        if p ~= L then
            if fl == "" or string.find(string.lower(p.Name),fl,1,true) then
                local row = Instance.new("Frame",list)
                row.Size = UDim2.new(1,-10,0,30)
                row.BackgroundColor3 = PN
                Instance.new("UICorner",row).CornerRadius = UDim.new(0,6)
                
                local nm = Instance.new("TextLabel",row)
                nm.Size = UDim2.new(0.4,0,1,0)
                nm.Position = UDim2.new(0,5,0,0)
                nm.BackgroundTransparency = 1
                nm.Text = p.Name
                nm.TextColor3 = Color3.fromRGB(255,255,255)
                nm.Font = Enum.Font.Gotham
                nm.TextSize = 10
                nm.TextXAlignment = Enum.TextXAlignment.Left
                
                local function sb(t,x,c)
                    local b = Instance.new("TextButton",row)
                    b.Size = UDim2.new(0.18,0,0,22)
                    b.Position = UDim2.new(x,0,0,4)
                    b.BackgroundColor3 = c
                    b.Text = t
                    b.TextColor3 = Color3.fromRGB(255,255,255)
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 9
                    Instance.new("UICorner",b).CornerRadius = UDim.new(0,5)
                    return b
                end
                
                local gb = sb("DEN",0.4,BL)
                local bb = sb("KEO",0.6,OR)
                local kb = sb("THEO",0.8,PU)
                
                gb.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then mh.CFrame = th.CFrame + Vector3.new(0,0,3) end
                    end
                end)
                
                bb.MouseButton1Click:Connect(function()
                    local mc, tc = L.Character, p.Character
                    if mc and tc then
                        local mh = mc:FindFirstChild("HumanoidRootPart")
                        local th = tc:FindFirstChild("HumanoidRootPart")
                        if mh and th then th.CFrame = mh.CFrame + Vector3.new(0,0,3) end
                    end
                end)
                
                kb.MouseButton1Click:Connect(function()
                    if keep[p] then
                        keep[p]:Disconnect()
                        keep[p] = nil
                        kb.Text = "THEO"
                        kb.BackgroundColor3 = PU
                    else
                        kb.Text = "THA"
                        kb.BackgroundColor3 = RD
                        keep[p] = R.Heartbeat:Connect(function()
                            local mc = L.Character
                            local tc = p.Character
                            if not mc or not tc then return end
                            local mh = mc:FindFirstChild("HumanoidRootPart")
                            local th = tc:FindFirstChild("HumanoidRootPart")
                            if mh and th then th.CFrame = mh.CFrame + Vector3.new(3,0,3) end
                        end)
                    end
                end)
            end
        end
    end
end

