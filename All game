-- ================= HÀM TIỆN ÍCH =================
local function addCorner(obj, r)
    local c = Instance.new("UICorner", obj)
    c.CornerRadius = UDim.new(0, r or 10)
    return c
end

local function addStroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke", obj)
    s.Color = color or BORDER
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.4
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function addGradient(obj, c1, c2, rot)
    local g = Instance.new("UIGradient", obj)
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2)
    }
    g.Rotation = rot or 45
    return g
end

local function makeButton(parent, text, y, color, height)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.92, 0, 0, height or 30)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = color or BLUE
    b.Text = text
    b.TextColor3 = WHITE
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    addCorner(b, 8)
    addStroke(b, WHITE, 1, 0.85)
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Color3.new(
            math.min(color.R + 0.15, 1),
            math.min(color.G + 0.15, 1),
            math.min(color.B + 0.15, 1)
        )
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = color
    end)
    return b
end

local function makeTextBox(parent, placeholder, y, default)
    local b = Instance.new("TextBox", parent)
    b.Size = UDim2.new(0.92, 0, 0, 28)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = INPUT
    b.PlaceholderText = placeholder
    b.Text = default or ""
    b.TextColor3 = WHITE
    b.PlaceholderColor3 = Color3.fromRGB(140, 140, 160)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.BorderSizePixel = 0
    addCorner(b, 6)
    addStroke(b, BORDER, 1, 0.6)
    return b
end

