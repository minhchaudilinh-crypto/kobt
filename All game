local showTeam = false

local espObjects = {}

-- Hàm tạo ESP cho 1 người
local function createESP(p)
    if not p.Character then return end
    if espObjects[p] then removeESP(p) end
    espObjects[p] = {parts = {}}

    local char = p.Character
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- Khung (Highlight)
    if showBox then
        local hl = Instance.new("Highlight")
        hl.FillColor = RED
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        table.insert(espObjects[p].parts, hl)
    end

    -- Billboard (tên + khoảng cách + máu)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 150, 0, 70)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head or char
    table.insert(espObjects[p].parts, bb)

    -- Tên
    if showName then
        local nm = Instance.new("TextLabel", bb)
        nm.Size = UDim2.new(1, 0, 0, 20)
        nm.BackgroundTransparency = 1
        nm.Text = p.Name
        nm.TextColor3 = Color3.fromRGB(255, 255, 255)
        nm.TextStrokeTransparency = 0
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 13
        espObjects[p].name = nm
    end

    -- Khoảng cách
    if showDist then
        local dl = Instance.new("TextLabel", bb)
        dl.Size = UDim2.new(1, 0, 0, 18)
        dl.Position = UDim2.new(0, 0, 0, 20)
        dl.BackgroundTransparency = 1
        dl.Text = "..."
        dl.TextColor3 = YELLOW
        dl.TextStrokeTransparency = 0
        dl.Font = Enum.Font.GothamBold
        dl.TextSize = 11
        espObjects[p].dist = dl
    end

    -- Thanh máu
    if showHp and hum then
        local hpBg = Instance.new("Frame", bb)
        hpBg.Size = UDim2.new(0.8, 0, 0, 6)
        hpBg.Position = UDim2.new(0.1, 0, 0, 40)
        hpBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        hpBg.BorderSizePixel = 0
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 3)

        local hpBar = Instance.new("Frame", hpBg)
        hpBar.Size = UDim2.new(1, 0, 1, 0)
        hpBar.BackgroundColor3 = GREEN
        hpBar.BorderSizePixel = 0
        Instance.new("UICorner", hpBar).CornerRadius = UDim.new(0, 3)

        espObjects[p].hpBar = hpBar
        espObjects[p].hpText = hpBg
    end

    -- Đường chỉ (Line)
    if showLine and head then
        local line = Instance.new("Frame", sg)
        line.BackgroundColor3 = RED
        line.BorderSizePixel = 0
        line.Size = UDim2.new(0, 1, 0, 1)
        line.ZIndex = 999
        espObjects[p].line = line
    end

    -- Cập nhật liên tục
    local conn = RS.RenderStepped:Connect(function()
        if not espActive then return end
        local myChar = LP.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        local tChar = p.Character
        if not tChar then return end
        local tHead = tChar:FindFirstChild("Head")
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if not tHrp or not tHead then return end

        -- Khoảng cách
        if espObjects[p].dist then
            local dist = math.floor((myHrp.Position - tHrp.Position).Magnitude)
            espObjects[p].dist.Text = dist .. " studs"
        end

        -- Thanh máu
        if espObjects[p].hpBar then
            local h = tChar:FindFirstChildOfClass("Humanoid")
            if h then
                local ratio = h.Health / h.MaxHealth
                espObjects[p].hpBar.Size = UDim2.new(ratio, 0, 1, 0)
                if ratio > 0.5 then
                    espObjects[p].hpBar.BackgroundColor3 = GREEN
                elseif ratio > 0.25 then
                    espObjects[p].hpBar.BackgroundColor3 = YELLOW
                else
                    espObjects[p].hpBar.BackgroundColor3 = RED
                end
            end
        end

        -- Đường chỉ
        if espObjects[p].line then
            local headPos, onScreen = cam:WorldToViewportPoint(tHead.Position)
            if onScreen then
                local startX = cam.ViewportSize.X / 2
                local startY = cam.ViewportSize.Y
                local endX = headPos.X
                local endY = headPos.Y
                local length = math.sqrt((endX - startX)^2 + (endY - startY)^2)
                local angle = math.atan2(endY - startY, endX - startX)
                espObjects[p].line.Position = UDim2.new(0, startX, 0, startY)
                espObjects[p].line.Size = UDim2.new(0, length, 0, 2)
                espObjects[p].line.Rotation = math.deg(angle)
                espObjects[p].line.Visible = true
            else
                espObjects[p].line.Visible = false
            end
        end
    end)
    espObjects[p].conn = conn
end

local function removeESP(p)
    if espObjects[p] then
        if espObjects[p].parts then
            for _, obj in pairs(espObjects[p].parts) do
                if obj and obj.Parent then obj:Destroy() end
            end
        end
        if espObjects[p].line and espObjects[p].line.Parent then espObjects[p].line:Destroy() end
        if espObjects[p].conn then espObjects[p].conn:Disconnect() end
        espObjects[p] = nil
    end
end

local function updateAllESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            if espActive then createESP(p) else removeESP(p) end
        end
    end
end

