-- ================= LOGIC BAY =================
local flyOn, flyConn, flyVelocity = false, nil, nil

flyBtn.MouseButton1Click:Connect(function()
    flyOn = not flyOn
    if flyOn then
        flyBtn.Text = "BAY: BẬT"
        flyBtn.BackgroundColor3 = RED
        flyPanel.Visible = true

        local c = LocalPlayer.Character
        if not c then flyOn = false; flyPanel.Visible = false; return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then flyOn = false; flyPanel.Visible = false; return end

        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyVelocity.Parent = hrp

        flyConn = RunService.RenderStepped:Connect(function()
            if not flyVelocity or not flyVelocity.Parent then return end
            local sp = tonumber(flyBox.Text) or 50
            local dir = Vector3.new(0, 0, 0)
            local look = Camera.CFrame.LookVector
            local right = Camera.CFrame.RightVector

            if flyInput.forward then dir = dir + look end
            if flyInput.back then dir = dir - look end
            if flyInput.right then dir = dir + right end
            if flyInput.left then dir = dir - right end
            if flyInput.up then dir = dir + Vector3.new(0, 1, 0) end
            if flyInput.down then dir = dir - Vector3.new(0, 1, 0) end

            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end

            flyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * sp or Vector3.new(0, 0, 0)
        end)
    else
        flyBtn.Text = "BAY: TẮT"
        flyBtn.BackgroundColor3 = BLUE
        flyPanel.Visible = false
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        for k, _ in pairs(flyInput) do flyInput[k] = false end
    end
end)

-- ================= LOGIC ESP =================
local espOn, showKhung, showTen, showKC, showMau = false, true, true, true, true
local espObjects = {}

local function removeESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do
            if obj and obj.Parent then obj:Destroy() end
        end
        espObjects[player] = nil
    end
end

local function createESP(player)
    if not player.Character then return end
    removeESP(player)

    local list = {}
    local char = player.Character
    local head = char:FindFirstChild("Head")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if showKhung then
        local hl = Instance.new("Highlight")
        hl.FillColor = RED
        hl.OutlineColor = WHITE
        hl.FillTransparency = 0.5
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        table.insert(list, hl)
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 160, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head or char
    table.insert(list, billboard)

    if showTen then
        local nameLbl = Instance.new("TextLabel", billboard)
        nameLbl.Size = UDim2.new(1, 0, 0, 20)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = player.Name
        nameLbl.TextColor3 = WHITE
        nameLbl.TextStrokeTransparency = 0
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 13
    end

    if showKC then
        local distLbl = Instance.new("TextLabel", billboard)
        distLbl.Size = UDim2.new(1, 0, 0, 18)
        distLbl.Position = UDim2.new(0, 0, 0, 20)
        distLbl.BackgroundTransparency = 1
        distLbl.Text = "..."
        distLbl.TextColor3 = YELLOW
        distLbl.TextStrokeTransparency = 0
        distLbl.Font = Enum.Font.GothamBold
        distLbl.TextSize = 11
        espObjects[player] = list
        espObjects[player].distLbl = distLbl
        table.insert(list, {
            Parent = nil,
        })
        espObjects[player].parts = list
    end

    if showMau and humanoid then
        local hpBg = Instance.new("Frame", billboard)
        hpBg.Size = UDim2.new(0.8, 0, 0, 6)
        hpBg.Position = UDim2.new(0.1, 0, 0, 42)
        hpBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        hpBg.BorderSizePixel = 0
        addCorner(hpBg, 3)

        local hpBar = Instance.new("Frame", hpBg)
        hpBar.Size = UDim2.new(1, 0, 1, 0)
        hpBar.BackgroundColor3 = GREEN
        hpBar.BorderSizePixel = 0
        addCorner(hpBar, 3)
        espObjects[player].hpBar = hpBar
    end

    espObjects[player].parts = list

    espObjects[player].conn = RunService.RenderStepped:Connect(function()
        if not espOn then return end
        if not espObjects[player] then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        local tChar = player.Character
        if not tChar then return end
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if not tHrp then return end

        if espObjects[player].distLbl then
            local d = math.floor((myHrp.Position - tHrp.Position).Magnitude)
            espObjects[player].distLbl.Text = d .. " studs"
        end

        if espObjects[player].hpBar then
            local h = tChar:FindFirstChildOfClass("Humanoid")
            if h then
                local r = h.Health / h.MaxHealth
                espObjects[player].hpBar.Size = UDim2.new(r, 0, 1, 0)
                if r > 0.5 then
                    espObjects[player].hpBar.BackgroundColor3 = GREEN
                elseif r > 0.25 then
                    espObjects[player].hpBar.BackgroundColor3 = YELLOW
                else
                    espObjects[player].hpBar.BackgroundColor3 = RED
                end
            end
        end
    end)
end

