-- ===== TROLL: RUNG LẮC =====
tShk.MouseButton1Click:Connect(function()
    if not selP or not selP.Character then return end
    local hrp = selP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.CFrame
    local n = 0
    local c
    c = R.Heartbeat:Connect(function()
        n = n + 1
        if n > 60 then c:Disconnect(); return end
        local ch = selP.Character
        if not ch then c:Disconnect(); return end
        local h = ch:FindFirstChild("HumanoidRootPart")
        if not h then c:Disconnect(); return end
        h.CFrame = pos * CFrame.new(math.random(-3,3)/10, math.random(-3,3)/10, math.random(-3,3)/10)
    end)
    tShk.BackgroundColor3 = YE
    wait(1)
    tShk.BackgroundColor3 = RD
end)

