local ivB = mkBtn(pgTool,"TÀNG HÌNH: TẮT",38,GR)
local fbB = mkBtn(pgTool,"ÁNH SÁNG: TẮT",71,GR)
local bhB = mkBtn(pgTool,"NHẢY LIÊN TỤC: TẮT",104,GR)
local ijB = mkBtn(pgTool,"NHẢY VÔ HẠN: TẮT",137,GR)

-- NOCLIP
local ncOn, ncConn = false, nil
ncB.MouseButton1Click:Connect(function()
    ncOn = not ncOn
    ncB.Text = ncOn and "XUYÊN TƯỜNG: BẬT" or "XUYÊN TƯỜNG: TẮT"
    ncB.BackgroundColor3 = ncOn and RD or GR
    if ncOn then
        ncConn = R.Stepped:Connect(function()
            local c = L.Character
            if c then
                for _,pt in pairs(c:GetDescendants()) do
                    if pt:IsA("BasePart") then pt.CanCollide = false end
                end
            end
        end)
    else
        if ncConn then ncConn:Disconnect(); ncConn = nil end
    end
end)

-- TÀNG HÌNH
local ivOn = false
local function setInvis(v)
    local c = L.Character
    if not c then return end
    for _,pt in pairs(c:GetDescendants()) do
        if pt:IsA("BasePart") or pt:IsA("Decal") then pt.Transparency = v and 1 or 0 end
    end
end
ivB.MouseButton1Click:Connect(function()
    ivOn = not ivOn
    ivB.Text = ivOn and "TÀNG HÌNH: BẬT" or "TÀNG HÌNH: TẮT"
    ivB.BackgroundColor3 = ivOn and RD or GR
    setInvis(ivOn)
end)
L.CharacterAdded:Connect(function() if ivOn then wait(0.5); setInvis(true) end end)

-- FULLBRIGHT
local fbOn = false
fbB.MouseButton1Click:Connect(function()
    fbOn = not fbOn
    fbB.Text = fbOn and "ÁNH SÁNG: BẬT" or "ÁNH SÁNG: TẮT"
    fbB.BackgroundColor3 = fbOn and RD or GR
    if fbOn then
        LT.Brightness = 3
        LT.ClockTime = 14
        LT.FogEnd = 100000
        LT.Ambient = Color3.fromRGB(200,200,200)
        LT.OutdoorAmbient = Color3.fromRGB(200,200,200)
    else
        LT.Brightness = 1
        LT.Ambient = Color3.fromRGB(70,70,70)
        LT.OutdoorAmbient = Color3.fromRGB(70,70,70)
    end
end)

-- BUNNY HOP
local bhOn, bhConn = false, nil
bhB.MouseButton1Click:Connect(function()
    bhOn = not bhOn
    bhB.Text = bhOn and "NHẢY LIÊN TỤC: BẬT" or "NHẢY LIÊN TỤC: TẮT"
    bhB.BackgroundColor3 = bhOn and RD or GR
    if bhOn then
        bhConn = R.Heartbeat:Connect(function()
            local c = L.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.MoveDirection.Magnitude > 0 then h.Jump = true end
        end)
    else
        if bhConn then bhConn:Disconnect(); bhConn = nil end
    end
end)

-- NHẢY VÔ HẠN
local ijOn = false
ijB.MouseButton1Click:Connect(function()
    ijOn = not ijOn
    ijB.Text = ijOn and "NHẢY VÔ HẠN: BẬT" or "NHẢY VÔ HẠN: TẮT"
    ijB.BackgroundColor3 = ijOn and RD or GR
end)
U.JumpRequest:Connect(function()
    if ijOn then
        local c = L.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end
end)

-- ========== XÁC NHẬN ==========
cB.MouseButton1Click:Connect(function()
    if pB.Text == "matcuoi290" then
        pF.Visible = false
        mF.Visible = true
        updateList()
    else
        eL.Text = "Sai mật khẩu!"
        pB.Text = ""
    end
end)
pB.FocusLost:Connect(function(e) if e then cB:Activate() end end)
