-- ==================== HÀM CHẠY LOADER ====================
local function runLoader()
    local url = "https://raw.githubusercontent.com/joustingmatch/Ouroboros/main/loader.lua"
    local success, err = pcall(function()
        local code = game:HttpGet(url)
        loadstring(code)()
    end)
    if success then
        print("[LeavesHub] Đã chạy loader thành công!")
    else
        warn("[LeavesHub] Lỗi khi chạy loader: " .. tostring(err))
    end
end

-- ==================== FLY ====================
RunService.RenderStepped:Connect(function()
    if _G.Fly and Character then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        local humanoid = Character:FindFirstChild("Humanoid")
        if hrp and humanoid then
            humanoid.PlatformStand = true
            local speed = 80
            local moveDir = Vector3.new(0, 0, 0)
            local camera = workspace.CurrentCamera

            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir + Vector3.new(0, -1, 0) end
            if _G.FlyDir.L then moveDir = moveDir + Vector3.new(-1, 0, 0) end
            if _G.FlyDir.R then moveDir = moveDir + Vector3.new(1, 0, 0) end
            if _G.FlyDir.U then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if _G.FlyDir.D then moveDir = moveDir + Vector3.new(0, -1, 0) end
            if _G.FlyDir.F then
                local camLook = camera.CFrame.LookVector
                moveDir = moveDir + Vector3.new(camLook.X, 0, camLook.Z)
            end

            if moveDir.Magnitude > 0 then hrp.Velocity = moveDir.Unit * speed
            else hrp.Velocity = Vector3.new(0, 0, 0) end
        end
    end
end)

-- ==================== TỐC ĐỘ ====================
local function setMySpeed(sp)
    if Character then local h = Character:FindFirstChild("Humanoid"); if h then h.WalkSpeed = sp end end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.SpeedMap then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.WalkSpeed < 100 then hum.WalkSpeed = 100 end
                end
            end
        end
    end
end)

