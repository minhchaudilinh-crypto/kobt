-- Vòng lặp cập nhật ESP thời gian thực
RunService.RenderStepped:Connect(function()
    -- Xử lý ESP Trứng (Lọc các độ hiếm cao: Legendary, Mythical, Secret,...)
    if isEspEgg then
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                -- Kiểm tra tên hoặc thuộc tính liên quan đến "Egg" và phân loại độ hiếm
                if obj:IsA("Model") and string.find(string.lower(obj.Name), "egg") then
                    local rarity = obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""
                    local lowerRarity = string.lower(tostring(rarity))
                    
                    -- Lọc các bậc từ Legendary trở lên
                    if string.find(lowerRarity, "legendary") or string.find(lowerRarity, "mythical") or string.find(lowerRarity, "secret") or obj:FindFirstChild("Legendary") then
                        if not obj:FindFirstChild("EggHighlight") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "EggHighlight"
                            hl.Adornee = obj
                            hl.FillColor = Color3.fromRGB(255, 215, 0) -- Màu vàng cho đồ hiếm
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.Parent = obj
                        end
                    end
                end
            end
        end)
    end

    -- Xử lý ESP Player
    if isEspPlayer then
        pcall(function()
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    if not player.Character:FindFirstChild("PlayerHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "PlayerHighlight"
                        hl.Adornee = player.Character
                        hl.FillColor = Color3.fromRGB(255, 0, 0) -- Màu đỏ cho người chơi khác
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = player.Character
                    end
                end
            end
        end)
    end
end)

