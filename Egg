SpeedBox.Parent = MainFrame

local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Size = UDim2.new(0, 85, 0, 35)
SpeedBtn.Position = UDim2.new(0.5, 35, 0, 100)
SpeedBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 14
SpeedBtn.Text = "Set Speed"
SpeedBtn.Font = Enum.Font.SourceSans
SpeedBtn.Parent = MainFrame

local customSpeed = 16
local speedConnection

SpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedBox.Text)
    if not val then return end
    customSpeed = val

    if speedConnection then speedConnection:Disconnect() end

    speedConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not rootPart then return end

            humanoid.WalkSpeed = customSpeed

            -- Đẩy velocity trực tiếp khi có hướng đi để chống rubberband
            local md = humanoid.MoveDirection
            if md.Magnitude > 0 then
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    md.X * customSpeed,
                    rootPart.AssemblyLinearVelocity.Y,
                    md.Z * customSpeed
                )
            end
        end)
    end)
end)

-- =========================
-- 3. Fly (fix nil Unit + respawn)
-- =========================
local FlyBtn = createButton("FlyBtn", 145, "Fly: OFF")
local isFlying = false
local flyConnection
local currentFlyBV

local function stopFly()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if currentFlyBV and currentFlyBV.Parent then currentFlyBV:Destroy() end
    currentFlyBV = nil
    FlyBtn.Text = "Fly: OFF"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    FlyBtn.Text = "Fly: ON"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "UncappedFlyVelocity"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart
    currentFlyBV = bv

    local renderEvent = RunService.PreRender or RunService.RenderStepped

    flyConnection = renderEvent:Connect(function()
        if not isFlying then return end
        pcall(function()
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            local rp = c:FindFirstChild("HumanoidRootPart")
            if not h or not rp then return end

            if not bv.Parent then bv.Parent = rp end

            -- FIX: tránh .Unit khi vector ngang = 0
            local look = Camera.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            local dir  = flat.Magnitude > 0.001 and flat.Unit or Vector3.new(0, 0, -1)

            if h.MoveDirection.Magnitude > 0 then
                bv.Velocity = dir * (h.MoveDirection.Magnitude * 60) + Vector3.new(0, 1.2, 0)
            else
                bv.Velocity = Vector3.zero
            end
        end)
    end)
end

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    if isFlying then startFly() else stopFly() end
end)

-- Nếu respawn khi đang fly → tự bật lại
LocalPlayer.CharacterAdded:Connect(function()
    if isFlying then
        task.wait(0.5)
        if currentFlyBV then currentFlyBV:Destroy(); currentFlyBV = nil end
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        startFly()
    end
end)

