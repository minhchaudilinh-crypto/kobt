-- Thuật toán tịnh tiến CFrame vi mô: Lừa Server rằng WalkSpeed vẫn là 16
RunService.RenderStepped:Connect(function(dt)
    if _G.SpeedHack then
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if humanoid and root and humanoid.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (humanoid.MoveDirection * (_G.SpeedValue * dt))
            end
        end)
    end
end)

MoveTab:AddToggle({
    Name = "Fly (Điều khiển bằng Joystick)",
    Default = false,
    Callback = function(Value)
        _G.Fly = Value
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        if _G.Fly then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "BypassFly"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = char.HumanoidRootPart
            
            _G.FlyConn = RunService.RenderStepped:Connect(function()
                pcall(function()
                    local cam = workspace.CurrentCamera
                    local hd = char.Humanoid
                    if hd.MoveDirection.Magnitude > 0 then
                        bv.Velocity = (cam.CFrame.LookVector * Vector3.new(1,0,1)).Unit * hd.MoveDirection.Magnitude * 60 + Vector3.new(0, 1, 0)
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                end)
            end)
        else
            if _G.FlyConn then _G.FlyConn:Disconnect() end
            if char.HumanoidRootPart:FindFirstChild("BypassFly") then
                char.HumanoidRootPart.BypassFly:Destroy()
            end
        end
    end    
})

