-- CƠ CHẾ BYPASS TELEPORT (Tránh lỗi BAC-5515)
-- Thay vì dịch chuyển tức thời, dùng Tween lướt nhân vật đi mượt mà để qua mặt Server
local function SafeTeleport(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local dist = (root.Position - targetCFrame.Position).Magnitude
    local timeToMove = dist / (speed or 80) -- Giới hạn tốc độ lướt an toàn
    
    local tween = TweenService:Create(root, TweenInfo.new(timeToMove, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    return tween
end

