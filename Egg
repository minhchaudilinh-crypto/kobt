-- 2. Speed Control (Dùng Heartbeat ổn định WalkSpeed)
local SpeedBox = Instance.new("TextBox")
SpeedBox.Size = UDim2.new(0, 140, 0, 32)
SpeedBox.Position = UDim2.new(0.5, -120, 0, 90)
SpeedBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.TextSize = 14
SpeedBox.PlaceholderText = "Tốc độ..."
SpeedBox.Text = "30"
SpeedBox.Font = Enum.Font.SourceSans
SpeedBox.Parent = MainFrame

local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Size = UDim2.new(0, 95, 0, 32)
SpeedBtn.Position = UDim2.new(0.5, 25, 0, 90)
SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 14
SpeedBtn.Text = "Set Speed"
SpeedBtn.Font = Enum.Font.SourceSans
SpeedBtn.Parent = MainFrame

local speedVal = 30
local speedLoop = nil
SpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedBox.Text)
    if val then
        speedVal = val
        if speedLoop then speedLoop:Disconnect() end
        speedLoop = RunService.Heartbeat:Connect(function()
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    LocalPlayer.Character.Humanoid.WalkSpeed = speedVal
                end
            end)
        end)
    end
end)

-- 3. Fly (Điều khiển bằng nút di chuyển Roblox / Joystick)
local FlyBtn = createButton("FlyBtn", 130, "Fly: OFF")
local isFlying = false
local flyConn

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    if isFlying then
        FlyBtn.Text = "Fly: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FixFlyVel"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = rootPart
        
        flyConn = RunService.RenderStepped:Connect(function()
            if not isFlying then return end
            pcall(function()
                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    bv.Velocity = (Camera.CFrame.LookVector * Vector3.new(1,0,1)).Unit * moveDir.Magnitude * 45 + Vector3.new(0, 1, 0)
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
            end)
        end)
    else
        FlyBtn.Text = "Fly: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        if flyConn then flyConn:Disconnect() end
        if rootPart:FindFirstChild("FixFlyVel") then
            rootPart.FixFlyVel:Destroy()
        end
    end
end)

-- 4. Auto Farm (Tự động đi máy chạy bộ và thu thập trứng Legendary+)
local AutoFarmBtn = createButton("AutoFarmBtn", 170, "Auto Farm: OFF")
local isAutoFarm = false

AutoFarmBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    if isAutoFarm then
        AutoFarmBtn.Text = "Auto Farm: ON"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            while isAutoFarm do
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                    local humanoid = char.Humanoid
                    
                    local target = nil
                    -- Tìm trứng độ hiếm cao (Legendary+)
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and string.find(string.lower(obj.Name), "egg") then
                            local rarity = tostring(obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""):lower()
                            if rarity:find("legendary") or rarity:find("mythical") or rarity:find("secret") or obj:FindFirstChild("Legendary") then
                                if obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") then
                                    target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                    break
                                end
                            end
                        end
                    end
                    
                    -- Nếu không có trứng hiếm, tìm máy chạy bộ (Treadmill)
                    if not target then
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") and (string.find(string.lower(obj.Name), "treadmill") or string.find(string.lower(obj.Name), "machine")) then
                                if obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") then
                                    target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                    break
                                end
                            end
                        end
                    end
                    
                    if target then
                        humanoid:MoveTo(target.Position)
                    end
                end)
                task.wait(2)
            end
        end)
    else
        AutoFarmBtn.Text = "Auto Farm: OFF"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

-- 5. ESP Trứng (Legendary trở lên)
local EspEggBtn = createButton("EspEggBtn", 210, "ESP Trứng (Legend+): OFF")
local isEspEgg = false

EspEggBtn.MouseButton1Click:Connect(function()
    isEspEgg = not isEspEgg
    if isEspEgg then
        EspEggBtn.Text = "ESP Trứng (Legend+): ON"
        EspEggBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        task.spawn(function()
            while isEspEgg do
                pcall(function()
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and string.find(string.lower(obj.Name), "egg") then
                            local rarity = string.lower(tostring(obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""))
                            if rarity:find("legendary") or rarity:find("mythical") or rarity:find("secret") or obj:FindFirstChild("Legendary") then
                                if not obj:FindFirstChild("EggHighlight") then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "EggHighlight"
                                    hl.Adornee = obj
                                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                    hl.Parent = obj
                                end
                            end
                        end
                    end
                end)
                task.wait(3)
            end
        end)
    else
        EspEggBtn.Text = "ESP Trứng (Legend+): OFF"
        EspEggBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EggHighlight" then v:Destroy() end
        end
    end
end)

-- 6. ESP Người chơi
local EspPlayerBtn = createButton("EspPlayerBtn", 250, "ESP Player: OFF")
local isEspPlayer = false

EspPlayerBtn.MouseButton1Click:Connect(function()
    isEspPlayer = not isEspPlayer
    if isEspPlayer then
        EspPlayerBtn.Text = "ESP Player: ON"
        EspPlayerBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        task.spawn(function()
            while isEspPlayer do
                pcall(function()
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            if not player.Character:FindFirstChild("PlayerHighlight") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "PlayerHighlight"
                                hl.Adornee = player.Character
                                hl.FillColor = Color3.fromRGB(255, 0, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.Parent = player.Character
                            end
                        end
                    end
                end)
                task.wait(3)
            end
        end)
    else
        EspPlayerBtn.Text = "ESP Player: OFF"
        EspPlayerBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PlayerHighlight") then
                p.Character.PlayerHighlight:Destroy()
            end
        end
    end
end)

