            end
        end)
    else
        EspEggBtn.Text = "ESP Trứng (Legend+): OFF"
        EspEggBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        for _, v in pairs(workspace:GetDescendants()) do
