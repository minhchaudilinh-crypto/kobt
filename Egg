-- 5. ESP Trứng (Legendary trở lên)
local EspEggBtn = createButton("EspEggBtn", 235, "ESP Trứng (Legend+): OFF")
local isEspEgg = false

EspEggBtn.MouseButton1Click:Connect(function()
    isEspEgg = not isEspEgg
    if isEspEgg then
        EspEggBtn.Text = "ESP Trứng (Legend+): ON"
        EspEggBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        task.spawn(function()
            while isEspEgg do
                pcall(function()
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and string.find(string.lower(obj.Name), "egg") then
                            local rarity = obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""
                            local lowerRarity = string.lower(tostring(rarity))
                            if string.find(lowerRarity, "legendary") or string.find(lowerRarity, "mythical") or string.find(lowerRarity, "secret") or obj:FindFirstChild("Legendary") then
                                if not obj:FindFirstChild("EggHighlight") then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "EggHighlight"
                                    hl.Adornee = obj
                                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                    hl.Parent = obj
                                end
                            end
                        end
                    end
                end)
                task.wait(2)
            end
        end)
    else
        EspEggBtn.Text = "ESP Trứng (Legend+): OFF"
        EspEggBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "EggHighlight" then v:Destroy() end
        end
    end
end)

-- 6. ESP Người chơi
local EspPlayerBtn = createButton("EspPlayerBtn", 280, "ESP Player: OFF")
local isEspPlayer = false

EspPlayerBtn.MouseButton1Click:Connect(function()
    isEspPlayer = not isEspPlayer
    if isEspPlayer then
        EspPlayerBtn.Text = "ESP Player: ON"
        EspPlayerBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        task.spawn(function()
            while isEspPlayer do
                pcall(function()
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            if not player.Character:FindFirstChild("PlayerHighlight") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "PlayerHighlight"
                                hl.Adornee = player.Character
                                hl.FillColor = Color3.fromRGB(255, 0, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.Parent = player.Character
                            end
                        end
                    end
                end)
                task.wait(2)
            end
        end)
    else
        EspPlayerBtn.Text = "ESP Player: OFF"
        EspPlayerBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PlayerHighlight") then
                p.Character.PlayerHighlight:Destroy()
            end
        end
    end
end)

