        currentSpeed = speedVal
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = currentSpeed
            end
        end)
    end
end)

-- Tự động áp dụng lại Speed khi nhân vật chết và hồi sinh
LocalPlayer.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.WalkSpeed = currentSpeed
    end
end)

-- 3. Fly (Sử dụng trực tiếp Humanoid.MoveDirection để tương thích hoàn toàn với nút di chuyển Roblox / Joystick mobile)
local FlyBtn = createButton("FlyBtn", 145, "Fly: OFF")
local isFlying = false
local flyConnection

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    if isFlying then
        FlyBtn.Text = "Fly: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "ExecFlyVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = rootPart
        
        -- Vô hiệu hóa trọng lực bằng cách tắt trạng thái ngã hoặc dùng PlatformStand nhẹ nếu cần
        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying then return end
            pcall(function()
                local cam = workspace.CurrentCamera
                -- Lấy hướng di chuyển trực tiếp từ bàn phím / joystick của Roblox (Humanoid.MoveDirection)
                local moveDir = humanoid.MoveDirection
                
                -- Nếu nhân vật đang bấm nút di chuyển, bay theo hướng camera kết hợp nút điều hướng
                if moveDir.Magnitude > 0 then
                    bv.Velocity = (cam.CFrame.LookVector * Vector3.new(1,0,1)).Unit * moveDir.Magnitude * 50 + Vector3.new(0, 2, 0)
                else
                    bv.Velocity = Vector3.new(0, 0, 0) -- Đứng yên lơ lửng khi không bấm di chuyển
                end
            end)
        end)
    else
        FlyBtn.Text = "Fly: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if flyConnection then flyConnection:Disconnect() end
        if rootPart:FindFirstChild("ExecFlyVelocity") then
            rootPart.ExecFlyVelocity:Destroy()
        end
    end
end)

