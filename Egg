-- Hàm tạo nút bấm (Button)
local function createButton(name, posY, text)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 240, 0, 35)
    btn.Position = UDim2.new(0.5, -120, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Text = text
    btn.Font = Enum.Font.SourceSans
    btn.Parent = MainFrame
    return btn
end

-- 1. Anti-AFK
local AntiAfkBtn = createButton("AntiAfkBtn", 55, "Anti-AFK: OFF")
local antiAfkConnection
local isAntiAfk = false

AntiAfkBtn.MouseButton1Click:Connect(function()
    isAntiAfk = not isAntiAfk
    if isAntiAfk then
        AntiAfkBtn.Text = "Anti-AFK: ON"
        AntiAfkBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        antiAfkConnection = LocalPlayer.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
    else
        AntiAfkBtn.Text = "Anti-AFK: OFF"
        AntiAfkBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if antiAfkConnection then
            antiAfkConnection:Disconnect()
        end
    end
end)

