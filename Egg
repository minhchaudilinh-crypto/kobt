-- 2. Uncapped Speed Control (Phá giới hạn tốc độ hoàn toàn bằng Vector Force / CFrame Velocity mở rộng)
local SpeedBox = Instance.new("TextBox")
SpeedBox.Size = UDim2.new(0, 150, 0, 35)
SpeedBox.Position = UDim2.new(0.5, -120, 0, 100)
SpeedBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.TextSize = 14
SpeedBox.PlaceholderText = "Nhập tốc độ tùy ý..."
SpeedBox.Text = "100"
SpeedBox.Font = Enum.Font.SourceSans
SpeedBox.Parent = MainFrame

local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Size = UDim2.new(0, 85, 0, 35)
SpeedBtn.Position = UDim2.new(0.5, 35, 0, 100)
SpeedBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 14
SpeedBtn.Text = "Set Speed"
SpeedBtn.Font = Enum.Font.SourceSans
SpeedBtn.Parent = MainFrame

local customSpeed = 16
local speedConnection
SpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedBox.Text)
    if val then
        customSpeed = val
        if speedConnection then speedConnection:Disconnect() end
        
        -- Dùng Heartbeat liên tục đẩy trực tiếp gia tốc HumanoidRootPart để bypass giới hạn WalkSpeed gốc của game
        speedConnection = RunService.Heartbeat:Connect(function(dt)
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                local humanoid = char.Humanoid
                local rootPart = char.HumanoidRootPart
                
                humanoid.WalkSpeed = customSpeed -- Vẫn ép WalkSpeed
                
                -- Nếu nhân vật đang di chuyển, cộng dồn vận tốc theo hướng di chuyển để không bị server rollback/tp lại
                if humanoid.MoveDirection.Magnitude > 0 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(
                        humanoid.MoveDirection.X * customSpeed,
                        rootPart.AssemblyLinearVelocity.Y,
                        humanoid.MoveDirection.Z * customSpeed
                    )
                end
            end)
        end)
    end
end)

-- 3. Fly (Chống giật ngược triệt để)
local FlyBtn = createButton("FlyBtn", 145, "Fly: OFF")
local isFlying = false
local flyConnection

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    local rootPart = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    if isFlying then
        FlyBtn.Text = "Fly: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "UncappedFlyVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = rootPart
        
        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying then return end
            pcall(function()
                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    bv.Velocity = (Camera.CFrame.LookVector * Vector3.new(1,0,1)).Unit * moveDir.Magnitude * 60 + Vector3.new(0, 1.2, 0)
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
            end)
        end)
    else
        FlyBtn.Text = "Fly: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if flyConnection then flyConnection:Disconnect() end
        if rootPart:FindFirstChild("UncappedFlyVelocity") then
            rootPart.UncappedFlyVelocity:Destroy()
        end
    end
end)

-- 4. Auto-Farm (Tự động di chuyển mượt bằng lệnh đi bộ để tránh bị quét lỗi dịch chuyển)
local AutoFarmBtn = createButton("AutoFarmBtn", 190, "Auto Farm: OFF")
local isAutoFarm = false

AutoFarmBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    if isAutoFarm then
        AutoFarmBtn.Text = "Auto Farm: ON"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            while isAutoFarm do
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                    local humanoid = char.Humanoid
                    
                    local targetObj = nil
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and string.find(string.lower(obj.Name), "egg") then
                            local rarity = tostring(obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""):lower()
                            if rarity:find("legendary") or rarity:find("mythical") or rarity:find("secret") or obj:FindFirstChild("Legendary") then
                                if obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") then
                                    targetObj = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                    break
                                end
                            end
                        end
                    end
                    
                    if not targetObj then
                        for _, obj in pairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") and (string.find(string.lower(obj.Name), "treadmill") or string.find(string.lower(obj.Name), "run") or string.find(string.lower(obj.Name), "machine")) then
                                if obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") then
                                    targetObj = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                    break
                                end
                            end
                        end
                    end
                    
                    if targetObj then
                        humanoid:MoveTo(targetObj.Position)
                    end
                end)
                task.wait(1.5)
            end
        end)
    else
        AutoFarmBtn.Text = "Auto Farm: OFF"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

