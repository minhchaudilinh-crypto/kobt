-- 4. Auto Farm
-- =========================
local AutoFarmBtn = createButton("AutoFarmBtn", 190, "Auto Farm: OFF")
local isAutoFarm = false

local function findTargetPart(keyword, needRare)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), keyword) then
            if needRare then
                local rarity = string.lower(tostring(obj:GetAttribute("Rarity") or obj:GetAttribute("Tier") or ""))
                local isRare = rarity:find("legendary") or rarity:find("mythical")
                    or rarity:find("secret") or obj:FindFirstChild("Legendary")
                if not isRare then continue end
            end
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then return part end
        end
    end
    return nil
end

AutoFarmBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    if isAutoFarm then
        AutoFarmBtn.Text = "Auto Farm: ON"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)

        task.spawn(function()
            while isAutoFarm do
                pcall(function()
                    local char = LocalPlayer.Character
                    if not char then return end
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if not humanoid then return end

                    local targetPart = findTargetPart("egg", true)
                        or findTargetPart("treadmill", false)
                        or findTargetPart("run", false)
                        or findTargetPart("machine", false)

                    if targetPart then
                        humanoid:MoveTo(targetPart.Position)
                    end
                end)
                task.wait(1.5)
            end
        end)
    else
        AutoFarmBtn.Text = "Auto Farm: OFF"
        AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

