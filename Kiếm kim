local function pickFast()
    -- 1. Gửi Remote PickHay — chính xác nhất
    if Pick then
        pcall(function() Pick:FireServer() end)
        pcall(function() Pick:FireServer() end)
    end
    -- 2. Nhấn E (tương tác game)
