local espOn = false; local espObjs = {}
local function isNeedleObj(o)
    if not o or (not o:IsA("BasePart") and not o:IsA("Model")) then return false end
    local n = o.Name:lower()
    for _,k in ipairs({"needle","kim","haystack","hidden"}) do if n:find(k) then return true end end
    return false
end
local function addESP(o)
    if espObjs[o] then return end
    local tp = o:IsA("Model") and (o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")) or o
    if not tp then return end
    local hl = Instance.new("Highlight"); hl.FillColor = Color3.fromRGB(255,0,0); hl.OutlineColor = Color3.fromRGB(255,255,0); hl.FillTransparency = 0.3; hl.Adornee = o; hl.Parent = o
    local bb = Instance.new("BillboardGui"); bb.Size = UDim2.new(0,120,0,35); bb.AlwaysOnTop = true; bb.Adornee = tp; bb.Parent = tp
    local lb = Instance.new("TextLabel"); lb.Size = UDim2.new(1,0,1,0); lb.BackgroundTransparency = 1; lb.TextColor3 = Color3.new(1,0,0); lb.Text = "🎯 "..o.Name; lb.TextSize = 12; lb.Font = Enum.Font.GothamBold; lb.Parent = bb
    espObjs[o] = {hl=hl,bb=bb}
end
local function clearESP() for _,d in pairs(espObjs) do pcall(function() d.hl:Destroy(); d.bb:Destroy() end) end; espObjs = {} end
