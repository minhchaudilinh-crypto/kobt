-- =============================================
-- 🎯 TÌM NÚT "XE BÁN TẢI" TRONG GUI
-- =============================================
local function FindTruckBtn()
    for _, g in ipairs(pg:GetDescendants()) do
        if (g:IsA("ImageButton") or g:IsA("TextButton")) and g.Visible then
            local txt = g.Text:lower()
            local name = g.Name:lower()
            if txt:find("xe bán tải") or txt:find("bán tải") or name:find("truck") or name:find("sell") then
                return g
            end
        end
    end
    -- Tìm theo vị trí góc phải màn hình (nút E trong hình)
    local vp = cam.ViewportSize
    for _, g in ipairs(pg:GetDescendants()) do
        if (g:IsA("ImageButton") or g:IsA("TextButton")) and g.Visible then
            local pos = g.AbsolutePosition
            local sz = g.AbsoluteSize
            if pos.X > vp.X * 0.6 and pos.Y > vp.Y * 0.3 and sz.X > 40 and sz.Y > 40 then
                return g
            end
        end
    end
    return nil
end

-- =============================================
-- ⚡ AUTO PICK = NHẤN NÚT XE BÁN TẢI + NHẤN E
-- =============================================
local function TapGui(btn)
    if not btn then return end
    local pos = btn.AbsolutePosition
    local sz = btn.AbsoluteSize
    local cx, cy = pos.X + sz.X/2, pos.Y + sz.Y/2
    pcall(function() VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1) end)
    task.wait(0.02)
    pcall(function() VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1) end)
end

local function Pick()
    -- 1. Gửi Remote
    if PickHay then
        pcall(function() PickHay:FireServer() end)
    end
    -- 2. Nhấn nút "Xe bán tải" trong màn hình
    local btn = FindTruckBtn()
    if btn then TapGui(btn) end
    -- 3. Nhấn phím E
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.025)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- =============================================
-- 💰 AUTO SELL — ĐẾN GẦN BÁN → QUAY LẠI
-- =============================================
local function GetSellParts()
    local t = {}
    pcall(function() for _,p in ipairs(CS:GetTagged("SellPart")) do if p:IsA("BasePart") then table.insert(t,p) end end end)
    return t
end

local function NearestSell()
    local best, minD = nil, math.huge
    for _,p in ipairs(GetSellParts()) do
        if hrp then
            local d = (p.Position - hrp.Position).Magnitude
            if d < minD then minD = d; best = p end
        end
    end
    return best, minD
end

local homePos = nil -- Lưu vị trí ban đầu để quay lại
local function GoSell()
    local sp, dist = NearestSell()
    if not sp or not hum then return false end
    -- Lưu vị trí hiện tại trước khi đi bán
    if not homePos and hrp then homePos = hrp.CFrame end
    -- Đi đến nơi bán
    if dist < 6 then return true end
    pcall(function() hum:MoveTo(sp.Position + Vector3.new(0,0,3)) end)
    task.wait(1.2)
    return true
end

local function GoHome()
    -- Quay lại vị trí ban đầu sau khi bán xong
    if homePos and hrp then
        pcall(function() hrp.CFrame = homePos; hrp.Velocity = Vector3.new(0,0,0) end)
        homePos = nil -- Xóa sau khi về
        task.wait(0.5)
    end
end

local function Sell()
    if not hrp then return end
    local ok = GoSell()
    if not ok then return end
    task.wait(0.4)
    -- Gửi Remote Sell
    if SellHay then
        for i=1,5 do
            pcall(function() SellHay:FireServer() end)
            task.wait(0.06)
        end
    end
    -- Kích hoạt tất cả cách bán
    for _,p in ipairs(GetSellParts()) do
        pcall(function() firetouchinterest(hrp,p,0); task.wait(0.05); firetouchinterest(hrp,p,1) end)
        pcall(function() local cd=p:FindFirstChildOfClass("ClickDetector"); if cd then fireclickdetector(cd) end end)
        pcall(function() local pp=p:FindFirstChildOfClass("ProximityPrompt"); if pp then fireproximityprompt(pp) end end)
    end
    task.wait(0.5)
    -- ✅ QUAY LẠI VỊ TRÍ CŨ → TIẾP TỤC NHẶT
    GoHome()
    lastSell = tick()
end

-- =============================================
-- 📖 ĐỌC TÚI — CHÍNH XÁC THEO HÌNH ẢNH
-- =============================================
local function GetBag()
    -- Tìm "Collect Hay (5/25)" hoặc "25/..."
    for _,g in ipairs(pg:GetDescendants()) do
        if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Visible then
            local txt = g.Text
            local c,m = txt:match("(%d+)%s*/%s*(%d+)")
            if c and m then
                local low = txt:lower()
                if low:find("collect") or low:find("hay") or tonumber(m) == 25 then
                    return tonumber(c), tonumber(m)
                end
            end
        end
    end
    -- Bất kỳ X/Y nào hợp lệ
    for _,g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local c,m = g.Text:match("(%d+)%s*/%s*(%d+)")
            if c and m then return tonumber(c), tonumber(m) end
        end
    end
    return nil, nil
end

