-- =============================================
-- 💰 AUTO SELL — ĐẾN GẦN + GỬI REMOTE
-- =============================================
local function GetSellParts()
    local t = {}
    pcall(function() for _,p in ipairs(CS:GetTagged("SellPart")) do if p:IsA("BasePart") then table.insert(t,p) end end end)
    return t
end

local function NearestSell()
    local best, minD = nil, math.huge
    for _,p in ipairs(GetSellParts()) do
        if hrp then
            local d = (p.Position - hrp.Position).Magnitude
            if d < minD then minD = d; best = p end
        end
    end
    return best, minD
end

local function GoSell()
    local sp, dist = NearestSell()
    if not sp or not hum then return false end
    if dist < 6 then return true end
    -- Đi bộ — KHÔNG TELE
    pcall(function() hum:MoveTo(sp.Position + Vector3.new(0,0,3)) end)
    task.wait(0.8)
    return true
end

local function Sell()
    if not hrp then return end
    local ok = GoSell()
    if not ok then return end
    task.wait(0.3)
    -- Gửi Remote chính xác
    if SellHay then
        for i=1,5 do
            pcall(function() SellHay:FireServer() end)
            task.wait(0.06)
        end
    end
    -- Kích hoạt tất cả cách bán
    for _,p in ipairs(GetSellParts()) do
        pcall(function() firetouchinterest(hrp,p,0); task.wait(0.05); firetouchinterest(hrp,p,1) end)
        pcall(function() local cd=p:FindFirstChildOfClass("ClickDetector"); if cd then fireclickdetector(cd) end end)
        pcall(function() local pp=p:FindFirstChildOfClass("ProximityPrompt"); if pp then fireproximityprompt(pp) end end)
    end
    lastSell = tick()
end

-- =============================================
-- 📖 ĐỌC TÚI — CẢI THIỆN CHÍNH XÁC
-- =============================================
local function GetBag()
    -- Ưu tiên tìm label có chữ hay
    for _,g in ipairs(pg:GetDescendants()) do
        if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Visible then
            local c,m = g.Text:match("(%d+)%s*/%s*(%d+)")
            if c and m then
                local txt = g.Text:lower()
                if txt:find("hay") or txt:find("collect") or txt:find("rơm") then
                    return tonumber(c), tonumber(m)
                end
            end
        end
    end
    -- Tìm bất kỳ X/Y nào
    for _,g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local c,m = g.Text:match("(%d+)%s*/%s*(%d+)")
            if c and m then return tonumber(c), tonumber(m) end
        end
    end
    return nil, nil
end

-- =============================================
-- 🎯 ESP KIM
-- =============================================
local ESP_On = false; local ESP_List = {}
local function IsNeedle(o)
    if not o or (not o:IsA("BasePart") and not o:IsA("Model")) then return false end
    local n = o.Name:lower()
    return n:find("needle") or n:find("kim") or n:find("haystack")
end
local function ESP_Add(o)
    if ESP_List[o] then return end
    local p = o:IsA("Model") and (o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")) or o
    if not p then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255,0,0)
    hl.OutlineColor = Color3.fromRGB(255,255,0)
    hl.FillTransparency = 0.3
    hl.Adornee = o; hl.Parent = o
    ESP_List[o] = hl
end
local function ESP_Clear() for _,v in pairs(ESP_List) do pcall(function() v:Destroy() end) end; ESP_List = {} end
task.spawn(function() while task.wait(0.5) do if ESP_On then for _,o in ipairs(workspace:GetDescendants()) do if IsNeedle(o) then ESP_Add(o) end end end end end)

