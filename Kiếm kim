-- =============================================
-- 💰 AUTO SELL — ĐẾN GẦN SELLPART + GỬI REMOTE
-- =============================================
local function getSellParts()
    local t = {}
    pcall(function() for _,p in ipairs(CS:GetTagged("SellPart")) do if p:IsA("BasePart") then table.insert(t,p) end end end)
    return t
end

local function getNearestSellPart()
    local best, minDist = nil, math.huge
    for _,p in ipairs(getSellParts()) do
        if hrp then
            local d = (p.Position - hrp.Position).Magnitude
            if d < minDist then minDist = d; best = p end
        end
    end
    return best, minDist
end

local function goToSellPart()
    local sp, dist = getNearestSellPart()
    if not sp or not hrp or not hum then return false end
    -- Nếu đã gần → không di chuyển
    if dist < 8 then return true end
    -- Đi đến sát SellPart — KHÔNG TELE
    pcall(function() hum:MoveTo(sp.Position + Vector3.new(math.random(-3,3), 0, math.random(-3,3))) end)
    task.wait(0.8)
    return true
end

local function doSellFull()
    if not hrp then return end
    -- 1. Đi đến nơi bán
    local ok = goToSellPart()
    if not ok then return end
    task.wait(0.3)
    -- 2. Gửi Remote SellHay — chính xác
    if Sell then
        for i = 1, 5 do
            pcall(function() Sell:FireServer() end)
            task.wait(0.08)
        end
    end
    -- 3. Kích hoạt tất cả cách tương tác
    for _,p in ipairs(getSellParts()) do
        pcall(function() firetouchinterest(hrp, p, 0); task.wait(0.05); firetouchinterest(hrp, p, 1) end)
        pcall(function() local cd = p:FindFirstChildOfClass("ClickDetector"); if cd then fireclickdetector(cd) end end)
        pcall(function() local pp = p:FindFirstChildOfClass("ProximityPrompt"); if pp then fireproximityprompt(pp) end end)
    end
    lastSellTick = tick()
end

-- =============================================
-- 📖 ĐỌC THÔNG TIN TÚI & TIỀN
-- =============================================
local function getBag()
    for _,g in ipairs(pg:GetDescendants()) do
        if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Visible then
            local cur, max = g.Text:match("(%d+)%s*/%s*(%d+)")
            if cur and max then
                local l = g.Text:lower()
                if l:find("hay") or l:find("rơm") or l:find("collect") then
                    return tonumber(cur), tonumber(max)
                end
            end
        end
    end
    for _,g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible then
            local cur, max = g.Text:match("(%d+)%s*/%s*(%d+)")
            if cur and max then return tonumber(cur), tonumber(max) end
        end
    end
    return nil, nil
end

