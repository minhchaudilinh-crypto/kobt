    local ok = pcall(function() gui.Parent = gethui() end)
    if ok then parented = true end
end
if not parented then
    local pg = Player:FindFirstChild("PlayerGui")
    if not pg then
        pg = Player:WaitForChild("PlayerGui", 10)
    end
    if pg then gui.Parent = pg end
end

