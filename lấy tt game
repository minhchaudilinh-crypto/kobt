copyBtn.MouseButton1Click:Connect(function()
    if gameInfoText == "" then
        statusLabel.Text = "Trạng thái: ⚠️ Chưa có dữ liệu!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        return
    end
    local success = false
    pcall(function()
        if setclipboard then setclipboard(gameInfoText); success = true
        elseif toclipboard then toclipboard(gameInfoText); success = true
        elseif syn and syn.write_clipboard then syn.write_clipboard(gameInfoText); success = true
        end
    end)
    if success then
        statusLabel.Text = "Trạng thái: 📋 Đã sao chép!"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
    else
        statusLabel.Text = "Trạng thái: ⚠️ Không sao chép được!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
end)

saveBtn.MouseButton1Click:Connect(function()
    if gameInfoText == "" then
        statusLabel.Text = "Trạng thái: ⚠️ Chưa có dữ liệu!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        return
    end
    local success = false
    pcall(function()
        if writefile then
            writefile("GameInfo_" .. game.PlaceId .. "_" .. os.time() .. ".txt", gameInfoText)
            success = true
        end
    end)
    if success then
        statusLabel.Text = "Trạng thái: 💾 Đã lưu file!"
        statusLabel.TextColor3 = Color3.fromRGB(180, 150, 255)
    else
        statusLabel.Text = "Trạng thái: ⚠️ Không lưu được file!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
end)

clearBtn.MouseButton1Click:Connect(function()
    clearLines()
    gameInfoText = ""
    statusLabel.Text = "Trạng thái: Đã xoá"
    statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    saveBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
end)

-- Kéo GUI trên Mobile
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

