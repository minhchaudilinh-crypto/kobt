-- Nút "Sao chép" → sao chép toàn bộ thông tin
copyBtn.MouseButton1Click:Connect(function()
    if gameInfoText == "" then
        statusLabel.Text = "Trạng thái: ⚠️ Chưa có dữ liệu để sao chép!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        return
    end

    -- Thử nhiều hàm sao chép khác nhau (tuỳ executor)
    local success = false
    pcall(function()
        if setclipboard then
            setclipboard(gameInfoText)
            success = true
        elseif toclipboard then
            toclipboard(gameInfoText)
            success = true
        elseif syn and syn.write_clipboard then
            syn.write_clipboard(gameInfoText)
            success = true
        end
    end)

    if success then
        statusLabel.Text = "Trạng thái: 📋 Đã sao chép!"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
    else
        statusLabel.Text = "Trạng thái: ⚠️ Executor không hỗ trợ sao chép!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
    end
end)

