-- Hàm thêm 1 dòng thông tin vào khung
local lineCount = 0
local function addLine(text, color)
    lineCount = lineCount + 1
    local line = Instance.new("TextLabel")
    line.Text = text
    line.Size = UDim2.new(1, -5, 0, 22)
    line.BackgroundTransparency = 0.8
    line.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    line.TextColor3 = color or Color3.fromRGB(220, 220, 220)
    line.TextScaled = true
    line.TextXAlignment = Enum.TextXAlignment.Left
    line.Font = Enum.Font.Code
    line.LayoutOrder = lineCount
    line.Parent = infoScroll
    -- Cập nhật kích thước khung cuộn
    infoScroll.CanvasSize = UDim2.new(0, 0, 0, lineCount * 25 + 10)
    -- Tự cuộn xuống dưới
    infoScroll.CanvasPosition = Vector2.new(0, infoScroll.AbsoluteCanvasSize.Y)
    return line
end

-- Hàm xoá toàn bộ thông tin
local function clearLines()
    for _, child in ipairs(infoScroll:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    lineCount = 0
    infoScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
end

-- ==========================================
-- HÀM LẤY THÔNG TIN GAME
-- ==========================================
local gameInfoText = "" -- Chuỗi để sao chép

local function collectGameInfo()
    clearLines()
    gameInfoText = ""
    statusLabel.Text = "Trạng thái: Đang lấy..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
    copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100) -- Vô hiệu hoá nút sao chép

    local function addToText(str)
        gameInfoText = gameInfoText .. str .. "\n"
    end

    local function section(titleStr)
        addLine("═════ " .. titleStr .. " ═════", Color3.fromRGB(0, 200, 255))
        addToText("───── " .. titleStr .. " ─────")
    end

    local function line(key, value)
        addLine("▸ " .. key .. ": " .. tostring(value))
        addToText(key .. ": " .. tostring(value))
    end

    -- Section 1: Thông tin game
    section("THÔNG TIN GAME")
    task.wait(0.15)

    local gameName = "Không rõ"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)
    line("Tên game", gameName)
    task.wait(0.1)

    line("Place ID", game.PlaceId)
    line("Job ID", game.JobId)
    line("Creator ID", game.CreatorId)
    line("Creator Type", tostring(game.CreatorType))
    task.wait(0.1)

    -- Section 2: Người chơi
    section("NGƯỜI CHƠI HIỆN TẠI")
    task.wait(0.1)
    line("Username", Player.Name)
    line("Display Name", Player.DisplayName)
    line("User ID", Player.UserId)
    line("Tuổi tài khoản", Player.AccountAge .. " ngày")
    line("Loại tài khoản", tostring(Player.MembershipType))
    task.wait(0.1)

    -- Section 3: Server
    section("THÔNG TIN SERVER")
    task.wait(0.1)
    line("Số người chơi", #Players:GetPlayers() .. "/" .. Players.MaxPlayers)
    line("Ping", math.floor(Player:GetNetworkPing() * 1000) .. " ms")
    line("Uptime", math.floor(Workspace.DistributedGameTime) .. " giây")
    task.wait(0.1)

    -- Danh sách người chơi
    addLine("── Danh sách người chơi ──", Color3.fromRGB(200, 200, 100))
    addToText("── Danh sách người chơi ──")
    for i, plr in ipairs(Players:GetPlayers()) do
        local tag = (plr == Player) and " (BẠN)" or ""
        addLine("  " .. i .. ". " .. plr.Name .. tag)
        addToText("  " .. i .. ". " .. plr.Name .. tag)
        task.wait(0.03)
    end
    task.wait(0.1)

    -- Section 4: Workspace
    section("WORKSPACE")
    task.wait(0.1)
    local partCount, modelCount, scriptCount, total = 0, 0, 0, 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        total = total + 1
        if obj:IsA("BasePart") then partCount = partCount + 1 end
        if obj:IsA("Model") then modelCount = modelCount + 1 end
        if obj:IsA("Script") or obj:IsA("LocalScript") then scriptCount = scriptCount + 1 end
    end
    line("Tổng object", total)
    line("Số Part", partCount)
    line("Số Model", modelCount)
    line("Số Script", scriptCount)
    task.wait(0.1)

    -- Section 5: ReplicatedStorage
    section("REPLICATEDSTORAGE")
    task.wait(0.1)
    local remotes, funcs, folders = {}, {}, 0
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then table.insert(remotes, obj.Name) end
        if obj:IsA("RemoteFunction") then table.insert(funcs, obj.Name) end
        if obj:IsA("Folder") then folders = folders + 1 end
    end
    line("Số RemoteEvent", #remotes)
    line("Số RemoteFunction", #funcs)
    line("Số Folder", folders)
    task.wait(0.1)

    if #remotes > 0 then
        addLine("── RemoteEvent ──", Color3.fromRGB(200, 200, 100))
        addToText("── RemoteEvent ──")
        for i, name in ipairs(remotes) do
            addLine("  " .. i .. ". " .. name)
            addToText("  " .. i .. ". " .. name)
            task.wait(0.03)
        end
    end

    -- Section 6: Môi trường
    section("MÔI TRƯỜNG")
    task.wait(0.1)
    line("Giờ trong game", Lighting.ClockTime)
    line("Độ sáng", Lighting.Brightness)
    line("Màu sương mù", tostring(Lighting.FogColor))
    line("Khoảng cách sương mù", Lighting.FogEnd)

    -- Kết thúc
    addLine("═════ HOÀN THÀNH ═════", Color3.fromRGB(50, 220, 80))
    addToText("═════ HOÀN THÀNH ═════")

    statusLabel.Text = "Trạng thái: ✅ Đã lấy xong!"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
    copyBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0) -- Bật lại nút sao chép
end

