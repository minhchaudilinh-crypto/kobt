-- HÀM LẤY THÔNG TIN
-- ==========================================
local gameInfoText = ""

local function collectGameInfo()
    clearLines()
    gameInfoText = ""
    statusLabel.Text = "Trạng thái: Đang lấy..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
    copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    saveBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

    local function addToText(str) gameInfoText = gameInfoText .. str .. "\n" end
    local function section(t)
        addLine("═════ " .. t .. " ═════", Color3.fromRGB(0, 200, 255))
        addToText("═══════════ " .. t .. " ═══════════")
    end
    local function line(k, v)
        addLine("▸ " .. k .. ": " .. tostring(v))
        addToText(k .. ": " .. tostring(v))
    end

    -- Thêm info GUI vào phần xuất
    addToText("📱 GUI tại TikTok: matcuoi290")
    addToText("")

    -- 1. GAME
    section("1. THÔNG TIN GAME")
    local gameName = "Không rõ"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)
    line("Tên game", gameName)
    line("Place ID", game.PlaceId)
    line("Job ID", game.JobId)
    line("Creator ID", game.CreatorId)
    line("Creator Type", tostring(game.CreatorType))
    task.wait(0.05)

    -- 2. NGƯỜI CHƠI
    section("2. NGƯỜI CHƠI HIỆN TẠI")
    line("Username", Player.Name)
    line("Display Name", Player.DisplayName)
    line("User ID", Player.UserId)
    line("Tuổi tài khoản", Player.AccountAge .. " ngày")
    if Player.Character then
        local hrp = Player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local p = hrp.Position
            line("Tọa độ", string.format("X=%.1f, Y=%.1f, Z=%.1f", p.X, p.Y, p.Z))
        end
        local hum = Player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            line("WalkSpeed", hum.WalkSpeed)
            line("JumpPower", hum.JumpPower)
            line("Máu", hum.Health .. "/" .. hum.MaxHealth)
        end
    end
    task.wait(0.05)

    -- 3. SERVER
    section("3. SERVER")
    pcall(function()
        line("Số người chơi", #Players:GetPlayers() .. "/" .. Players.MaxPlayers)
    end)
    pcall(function()
        line("Ping", math.floor(Player:GetNetworkPing() * 1000) .. " ms")
    end)
    pcall(function()
        line("Uptime", math.floor(Workspace.DistributedGameTime) .. " giây")
    end)
    pcall(function()
        local t0 = tick()
        RunService.Heartbeat:Wait()
        local dt = tick() - t0
        if dt > 0 then
            line("FPS (ước tính)", math.floor(1 / dt) .. " FPS")
        end
    end)
    task.wait(0.05)

    -- Danh sách người chơi
    addLine("── Danh sách người chơi ──", Color3.fromRGB(200, 200, 100))
    addToText("── Danh sách người chơi ──")
    local players = Players:GetPlayers()
    for i, plr in ipairs(players) do
        local tag = (plr == Player) and " (BẠN)" or ""
        local pos = "?"
        if plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pos = string.format("(%.0f,%.0f,%.0f)", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
            end
        end
        local t = "  " .. i .. ". " .. plr.Name .. tag .. " " .. pos
        addLine(t, tag ~= "" and Color3.fromRGB(100, 255, 120) or nil)
        addToText(t)
    end
    task.wait(0.05)

    -- 4. WORKSPACE
    section("4. WORKSPACE")
    local partCount, modelCount, scriptCount, total, meshCount = 0, 0, 0, 0, 0
    local npcs, vehicles = {}, {}
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            total = total + 1
            if obj:IsA("BasePart") then partCount = partCount + 1 end
            if obj:IsA("MeshPart") then meshCount = meshCount + 1 end
            if obj:IsA("Model") then
                modelCount = modelCount + 1
                local n = obj.Name:lower()
                if n:find("npc") or n:find("dummy") or n:find("enemy") then
                    table.insert(npcs, obj.Name)
                end
                if n:find("car") or n:find("vehicle") or n:find("truck") or n:find("xe") then
                    table.insert(vehicles, obj.Name)
                end
            end
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                scriptCount = scriptCount + 1
            end
        end
    end)
    line("Tổng object", total)
    line("Số Part", partCount)
    line("Số MeshPart", meshCount)
    line("Số Model", modelCount)
    line("Số Script", scriptCount)
    line("Số NPC (đoán)", #npcs)
    line("Số phương tiện (đoán)", #vehicles)
    task.wait(0.05)

    -- 5. TOẠ ĐỘ VẬT THỂ
    section("5. TOẠ ĐỘ VẬT THỂ")

    addLine("── Người chơi khác ──", Color3.fromRGB(200, 200, 100))
    addToText("── Người chơi khác ──")
    for _, plr in ipairs(players) do
        if plr ~= Player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = hrp.Position
                local t = "  " .. plr.Name .. ": X=" .. string.format("%.1f", p.X) .. " Y=" .. string.format("%.1f", p.Y) .. " Z=" .. string.format("%.1f", p.Z)
                addLine(t)
                addToText(t)
            end
        end
    end
    task.wait(0.03)

    if #npcs > 0 then
        addLine("── NPC (đoán) ──", Color3.fromRGB(200, 200, 100))
        addToText("── NPC ──")
        local dem = 0
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n:find("npc") or n:find("enemy") or n:find("dummy") then
                        dem = dem + 1
                        if dem <= 15 then
                            local p = obj:GetPivot().Position
                            local t = "  " .. obj.Name .. ": X=" .. string.format("%.1f", p.X) .. " Y=" .. string.format("%.1f", p.Y) .. " Z=" .. string.format("%.1f", p.Z)
                            addLine(t)
                            addToText(t)
                        end
                    end
                end
            end
        end)
        if dem > 15 then
            addLine("  ... và " .. (dem - 15) .. " NPC nữa")
            addToText("  ... và " .. (dem - 15) .. " nữa")
        end
    end
    task.wait(0.03)

    -- Vật thể gần bạn
    if Player.Character then
        local hrp = Player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            addLine("── Vật thể gần bạn (<30 studs) ──", Color3.fromRGB(200, 200, 100))
            addToText("── Vật thể gần bạn (<30 studs) ──")
            local count = 0
            pcall(function()
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Parent ~= Player.Character then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist < 30 then
                            count = count + 1
                            if count <= 15 then
                                local t = "  " .. obj.Name .. " | dist=" .. string.format("%.1f", dist)
                                addLine(t)
                                addToText(t)
                            end
                        end
                    end
                end
            end)
            if count == 0 then
                addLine("  (Không có vật thể nào)")
                addToText("  (Không có)")
            end
        end
    end
    task.wait(0.05)

    -- 6. CAMERA
    section("6. CAMERA")
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then
            local c = cam.CFrame.Position
            line("Vị trí camera", string.format("X=%.1f, Y=%.1f, Z=%.1f", c.X, c.Y, c.Z))
            line("FOV", cam.FieldOfView)
            line("CameraType", tostring(cam.CameraType))
        end
    end)
    task.wait(0.05)

    -- 7. REPLICATEDSTORAGE
    section("7. REPLICATEDSTORAGE")
    local remotes, funcs, modules = {}, {}, {}
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then table.insert(remotes, obj:GetFullName()) end
            if obj:IsA("RemoteFunction") then table.insert(funcs, obj:GetFullName()) end
            if obj:IsA("ModuleScript") then table.insert(modules, obj.Name) end
        end
    end)
    line("Số RemoteEvent", #remotes)
    line("Số RemoteFunction", #funcs)
    line("Số ModuleScript", #modules)

    if #remotes > 0 then
        addLine("── RemoteEvent (30 đầu) ──", Color3.fromRGB(200, 200, 100))
        addToText("── RemoteEvent ──")
        for i, name in ipairs(remotes) do
            if i <= 30 then
                local t = "  " .. i .. ". " .. name
                addLine(t)
                addToText(t)
            end
        end
        if #remotes > 30 then
            addLine("  ... và " .. (#remotes - 30) .. " nữa")
            addToText("  ... và " .. (#remotes - 30) .. " nữa")
        end
    end
    task.wait(0.05)

    -- 8. TAGS
    section("8. TAGS")
    local tags = {}
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local ot = CollectionService:GetTags(obj)
            for _, tag in ipairs(ot) do
                tags[tag] = (tags[tag] or 0) + 1
            end
        end
    end)
    local tagCount = 0
    for tag, count in pairs(tags) do
        tagCount = tagCount + 1
        if tagCount <= 30 then
            local t = "  " .. tagCount .. ". " .. tag .. " (" .. count .. ")"
            addLine(t)
            addToText(t)
        end
    end
    if tagCount == 0 then
        addLine("  (Không có tag nào)")
        addToText("  (Không có)")
    end
    task.wait(0.05)

    -- 9. MÔI TRƯỜNG
    section("9. MÔI TRƯỜNG")
    pcall(function() line("Giờ trong game", string.format("%.2f", Lighting.ClockTime)) end)
    pcall(function() line("Độ sáng", Lighting.Brightness) end)
    pcall(function() line("Màu sương mù", tostring(Lighting.FogColor)) end)
    pcall(function() line("FogEnd", Lighting.FogEnd) end)
    pcall(function() line("Ambient", tostring(Lighting.Ambient)) end)
    task.wait(0.05)

    -- 10. TOOL
    section("10. TOOL BACKPACK")
    pcall(function()
        local bp = Player:FindFirstChild("Backpack")
        if bp then
            local tools = bp:GetChildren()
            line("Số tool", #tools)
            for i, tool in ipairs(tools) do
                if tool:IsA("Tool") then
                    local t = "  " .. i .. ". " .. tool.Name
                    addLine(t)
                    addToText(t)
                end
            end
        end
        if Player.Character then
            local held = Player.Character:FindFirstChildOfClass("Tool")
            if held then
                line("Đang cầm", held.Name)
            end
        end
    end)
    task.wait(0.05)

    -- 11. ÂM THANH
    section("11. ÂM THANH ĐANG PHÁT")
    local sounds = {}
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Sound") and obj.IsPlaying then
                table.insert(sounds, obj.Name)
            end
        end
    end)
    line("Số âm thanh", #sounds)
    for i, s in ipairs(sounds) do
        if i <= 10 then
            addLine("  " .. i .. ". " .. s)
            addToText("  " .. i .. ". " .. s)
        end
    end
    task.wait(0.05)

    -- 12. ATTRIBUTES
    section("12. ATTRIBUTES GAME")
    local attrCount = 0
    pcall(function()
        for k, v in pairs(game:GetAttributes()) do
            attrCount = attrCount + 1
            local t = "  " .. k .. " = " .. tostring(v)
            addLine(t)
            addToText(t)
        end
    end)
    if attrCount == 0 then
        addLine("  (Không có)")
        addToText("  (Không có)")
    end
    task.wait(0.05)

    -- 13. STARTERPACK
    section("13. STARTERPACK & GUI")
    pcall(function() line("StarterPack items", #StarterPack:GetChildren()) end)
    pcall(function() line("Số PlayerGui", #Player:FindFirstChild("PlayerGui"):GetChildren()) end)
    task.wait(0.05)

    -- Kết
    addLine("═════ ✅ HOÀN THÀNH ═════", Color3.fromRGB(50, 220, 80))
    addToText("═══════════ ✅ HOÀN THÀNH ═══════════")
    addToText("Thời gian: " .. os.date("%Y-%m-%d %H:%M:%S"))
    addToText("📱 GUI tại TikTok: matcuoi290")

    statusLabel.Text = "Trạng thái: ✅ Xong! (" .. lineCount .. " mục)"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
    copyBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    saveBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 180)

    print("✅ [GameInfo] Đã lấy xong " .. lineCount .. " mục!")
end

